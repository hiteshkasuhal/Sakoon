<script>
    $('.slider_{{ section.id }}').slick({
  dots: true,
  speed: 300,
  slidesToShow: 1,
  slidesToScroll: 1,
  autoplay: false,
  infinite: true,
  cssEase:'linear',
    prevArrow: $('.prev_{{ section.id }}_main_slider'),
    nextArrow: $('.next_{{ section.id }}_main_slider'),
      responsive: [
    {
      breakpoint: 915,
      settings: {
        slidesToShow:1, 
        slidesToScroll: 1, 
      }
    }
  ]
 
});
  
$(document).on("click", '.trigger_{{ section.id }}', function(e) {
     e.preventDefault(); 
var this_element =  jQuery(this);
this_element.addClass('loading_hk');
var id = jQuery(this).attr('variant_id');
var plan = jQuery(this).attr('selling_plan');
var subscription = $('input[name="subscription"]:checked').val();
if (subscription == 'subscribe'){
jQuery.ajax({
type: 'POST',
url: '/cart/add.js',
data: {
  quantity: 1,
  id: id,
  selling_plan:plan
},
  dataType: 'json', 
 success: function (data) { 
jQuery("cart-drawer").load(location.href + " #CartDrawer");
setTimeout(function() {
jQuery("cart-drawer").removeClass('is-empty').addClass('active');
jQuery("body ").addClass('overflow-hidden');
this_element.removeClass('loading');
}, 1000);
 } 
 });
} else {
jQuery.ajax({
type: 'POST',
url: '/cart/add.js',
data: {
  quantity: 1,
  id: id
},
  dataType: 'json', 
 success: function (data) { 
jQuery("cart-drawer").load(location.href + " #CartDrawer");
setTimeout(function() {
jQuery("cart-drawer").removeClass('is-empty').addClass('active');
jQuery("body ").addClass('overflow-hidden');
this_element.removeClass('loading');
}, 1000);
 } 
 });
}
  });

$(document).on("change", '.option_item input', function(e) {
var subscription = $('input[name="subscription"]:checked').val();
var selected_id = $(this).parents('.options_flex').find('.option_item input:checked').val();
var selected_variant = $(this).parents('.options_flex').find('.option_item input:checked').val();
if (subscription == 'subscribe'){
  selected_variant = selected_variant+'_sub';
}
$('.option_item input:not(:checked)[value="'+selected_variant+'"]').trigger('click');
$('span.custom_checkout_button').attr('variant_id',selected_id); 
$('.price_trigger').hide();
$('.price_trigger[data_tab="'+selected_variant+'"]').show();
$('.price_main_right .price_trigger[data_tab="'+selected_id+'"]').show();

});


  $(document).on("change", 'input[name="subscription"]', function(e) {
var subscription = $('input[name="subscription"]:checked').val();
var selected_id = $('.options_flex').find('.option_item input:checked').val();
var selected_variant = $('.options_flex').find('.option_item input:checked').val();
if (subscription == 'subscribe'){
  selected_variant = selected_variant+'_sub';
}
$('.option_item input:not(:checked)[value="'+selected_variant+'"]').trigger('click');
$('span.custom_checkout_button').attr('variant_id',selected_id); 
$('.price_trigger').hide();
$('.price_trigger[data_tab="'+selected_variant+'"]').show();
$('.price_main_right .price_trigger[data_tab="'+selected_id+'"]').show();

});



  document.addEventListener('scroll', () => {
     function isInViewport(element) {
       const rect = element.getBoundingClientRect();
       return(rect.top >= 0 && rect.left >= 0 && rect.bottom <= (window.innerHeight || document.documentElement.clientHeight) && rect.right <= (window.innerWidth || document.documentElement.clientWidth));
     }

     if ( ! isInViewport(document.querySelector('.section1_heading')) &&  ! isInViewport(document.querySelector('.section1_buttonUnder_flex'))
         &&  ! isInViewport(document.querySelector('.section1_text'))) {
       document.querySelector('.custom_stcky_button').classList.add("sticky_button");
     } else {
       document.querySelector('.custom_stcky_button').classList.remove("sticky_button");
     }
   });
</script>





