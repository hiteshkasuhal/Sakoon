{%- style -%}
  .landing_header {
    padding-top: {{ section.settings.padding_top | times: 0.41 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.41 | round: 0 }}px;
    overflow:hidden;
  }
   
   @media screen and (min-width: 767px) {
    .landing_header {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
  }
 
  @media screen and (min-width: 1024px) {
    .landing_header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .desk_header, .mobile_header {
      display: none !important;
  }
  .mainlogo img {
      max-width: 160px;
      width: 100%;
  }
  .landing_header {
      border-bottom: 1px solid #DADADB;
  }

  @media screen and (max-width: 991px) {

  }
  @media screen and (max-width: 767px) {
    .mainlogo img {
        max-width: 106px;
    }
  }
{%- endstyle -%}

<section class="landing_header" style="background-color:{{section.settings.bgcolor}};color:{{section.settings.textcolor}};">
   <div class="container">
    <div class="row">
      <div class="col-12">
        <div class="mainlogo text-center">
          {% if section.settings.headerlogo != blank %}
          <a href="{{section.settings.logolink}}">
            <img src="{{ section.settings.headerlogo | img_url: 'master' }}" class="img-fluid" />
          </a>
          {% endif %}
        </div>
      </div>
    </div>
   </div>
</section>


{% schema %}
  {
    "name": "Landing Header",
    "settings": [
      {
        "type": "color",
        "id": "bgcolor",
        "label": "Background Color"
      },
      {
        "type": "color",
        "id": "textcolor",
        "label": "Text Color"
      },
      {
        "type": "url",
        "id": "logolink",
        "label": "Logo Link"
      },
      {
        "type": "image_picker",
        "id": "headerlogo",
        "label": "Header Logo"  
      },
      {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
    ],
    "presets": [
      {
        "name": "Landing Header"
      }
    ]
  }
{% endschema %}
