        $(".product-subscription .acctitle > a .accicon").removeClass("minus").addClass("plus");
      } else {
        $(".product-subscription .acctitle > a .accicon").removeClass("minus").addClass("plus");
        $(this).find(".accicon").removeClass("plus").addClass("minus");
        $(".product-subscription .acctitle > a").removeClass("active");
