    <div class="product_subscription_products">
        {%- comment -%} Products Variants {%- endcomment -%}
        {% for variant in product.variants %}
        {% assign best_value_class = "" %}
        {% assign variant_img = "" %}
        {% assign selected = "" %}

        {% if variant.featured_image %}

        {% assign variant_img = variant.featured_image | img_url: 'x300' %}

        {% else %}

        {% assign variant_img = product.featured_image | img_url: 'x300' %}

        {% endif %}

        {% if forloop.first %}
        {% assign selected = "selected" %}  
        {% else %}
        {% assign selected = "" %}  
        {% endif %}

        {% if forloop.last %}
        {% assign best_value_class = "rd trsf" %}
        {% endif %}

        <div class="product_pakage {{selected}}"  tabindex="{{forloop.index}}" data-variant-id="{{variant.id}}">
          {% if forloop.index == 3 %}
            {% assign priceDifference = variant.compare_at_price | minus: variant.price %}
            <span class="best_value_new">BEST VALUE</span>
          {% endif %}
          <div class="main_pakage"></div>
          <div class="product_pakage_img_container">
            <img loading="lazy" src="{{variant_img}}">
          </div>
          <h5>{{variant.title}}</h5>
            {% if forloop.index > 1 %}
              <span class="free_shipping">Includes Free Shipping</span>
              {% endif %}
          <h6 class="{{best_value_class}}">
            <span class="original-price--js one_time" data-type="onetime"  {% if product.selected_or_first_available_selling_plan_allocation %}style="display:none"{% endif %} >
             {% if variant.compare_at_price %}
                    <div class="old-price">{{ variant.compare_at_price | money }}</div> 
                    <div class="original-price" data-price="{{ variant.price | money }}">
                        {{ variant.price | money }}  
                    </div>
                    {% assign priceDifference = variant.compare_at_price | minus: variant.price %}
                    <div class="price-difference">
                        SAVE {{ priceDifference | times:100 | divided_by: variant.compare_at_price | round | replace:'29','30' }}%
                    </div>
                {% else %}
                    <div class="original-price" data-price="{{ variant.price | money }}">
                        {{ variant.price | money }}  
                    </div>
              {% endif %}
                                    
              <div class="save_price"></div>
            </span>
            {% if product.selected_or_first_available_selling_plan_allocation %}
              <span class="original-price--js sub_time">
                    
                  {% if variant.compare_at_price %}
                    <span class="old-price">{{variant.compare_at_price | money}}</span> 
                  {% endif %}
                  <span class="original-price" data-price="{{ variant.price | money }}">{{ variant.price | money }}</span>
                  <div class="ogr-cprice">{{ variant.selling_plan_allocations.first.price | money }}</div>

                 {% assign priceDifference = variant.price | minus: variant.selling_plan_allocations.first.price %}
                      <div class="price-difference">
                          SAVE {{ priceDifference | times:100 | divided_by: variant.price | round | replace:'29','30' }}%
                      </div>
                
                <div class="save_price"></div>
              </span>
            {% endif %}  
          </h6>
         {% comment %} {% if forloop.last %}
          <h6 class="best_value rd">BEST VALUE</h6>
          {% endif %} {% endcomment %}
        </div>
        {% endfor %}
    </div>

         
