<style>
  .pdp_scroll-background .pdp_scroll-background__inner {
    width: 100%;
    height: 282px;
    top: 0;
    left: 0; 
    background-repeat: repeat-x;
    background-size: auto 100%;
    animation: moveSlide 50s linear infinite;
    {% if product.metafields.custom.banner_image != blank %}
    background-image: url({{product.metafields.custom.banner_image | img_url : 'master'}});
    {% else %}
    background-image: url({{section.settings.product_slider | img_url : 'master'}});
    {% endif %}
  }
  @media (max-width: 1500px){
    .pdp_scroll-background .pdp_scroll-background__inner {
      height: 212px;
    }
  }
  @keyframes moveSlide{
    0% {
      background-position: 0;
    }
    100% {
      background-position: -1200px;
    }
  }
  
</style>

{%- style -%}
  .product-section  {
    padding-top: {{ section.settings.padding_top | times: 0.60 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.16 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .product-section  {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

