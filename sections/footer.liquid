{% schema %}
  {
    "name": "Footer",
    "settings": [
                 {
                        "type": "select",
                        "id": "logo",
                        "label": "Logo Img Or Svg",
                        "options": [
                    {
                        "value": "img",
                        "label": "Img"
                    },
                    {
                        "value": "svg",
                        "label": "SVG"
                    }
                    
                    ],
                        "default": "svg"
                    },
                   {
                         "type":"image_picker",
                         "id":"logo-img",
                         "label":"Select Logo"
                    },
                    {
                         "type":"text",
                         "id":"logo-svg",
                         "label":"Svg Src"
                    },
                    {
                        "type":"text",
                        "id":"heading2",
                        "label":"Newsletter Heading"
                    },
                    {
                        "type":"header",
                        "content":"Social Link's"
                    },
                    {
                        "type":"url",
                        "id":"instagram",
                        "label":"Instagram Link"
                    },
                    {
                        "type":"url",
                        "id":"facebook",
                        "label":"Facebook Link"
                    },
                    {
                        "type":"url",
                        "id":"youtube",
                        "label":"Youtube Link"
                    },
                    {
                        "type":"url",
                        "id":"twitter",
                        "label":"Twitter Link"
                    },
                    {
                        "type":"link_list",
                        "id":"policy",
                        "label":"Policy Menu"
                    },
                    {
                        "type":"text",
                        "id":"copyright",
                        "label":"Copyright Text"
                    }
                    
                ],
    "blocks":[
      {
        "type":"link",
        "name":"Link List",
        "settings":[
          {
            "type":"text",
            "id":"heading",
            "label":"Heading"
          },
          {  
            "type":"link_list",
            "id":"menu",
            "label":"Select Menu"
          }
        ]
      }
    ]
  }
{% endschema %}

