<section class="landing_product color-{{ section.settings.color_scheme }} {% if section.settings.secondary_background %}background-secondary{% else %}gradient{% endif %}">
  <div class="page-width section-{{ section.id }}-padding{% if section.settings.secondary_background %} isolate{% endif %}">
    <div class="featured-product landing_page product product--{{ section.settings.media_size }} grid grid--1-col gradient color-{{ section.settings.color_scheme }} product--{{ section.settings.media_position }}{% if section.settings.secondary_background == false %} isolate{% endif %} {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
      <div class="grid__item product__media-wrapper{% if section.settings.media_position == 'right' %} medium-hide large-up-hide{% endif %}">
        <media-gallery
          id="MediaGallery-{{ section.id }}"
          role="region"
          aria-label="{{ 'products.product.media.gallery_viewer' | t }}"
          data-desktop-layout="stacked"
        >
          <div id="GalleryViewer-{{ section.id }}" class="product__media-list">
            {%- if product.selected_or_first_available_variant.featured_media != null -%}
              {%- assign media = product.selected_or_first_available_variant.featured_media -%}


              <div class="slider-for">
                {% for media in product.media %}
                {% case media.media_type %}
                {% when 'image' %}

                <a href="{{ media | img_url: 'master' }}" class="item-slick">

                  <img src="{{ media | img_url: '800x800' }}" alt="Alt">

                </a>
                {% when 'video' %}
                <div class="product-single__video myclass">
                  {{ media | video_tag:  controls: true, autoplay: false }}
                </div>

                {% endcase %}

                {% endfor %}

              </div>



              
              <div class="slider-nav asdasd">
                {% for media in product.media %}
                {% case media.media_type %}
                {% when 'image' %}

                <div class="item-slick"><img src="{{ media | img_url: '150x150' }}" alt="Alt"></div>

                {% when 'video' %}

                <img src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/sakoon_yellow_square_logo_aa64137e-47f7-4890-a8ac-0dafac908eb4.png?v=1642501474" >


                {% endcase %}

                {% endfor %}
              </div>

               
              <div class="product__media-item" data-media-id="{{ section.id }}-{{ media.id }}">
                {% render 'product-thumbnail',
                  media: media,
                  position: 'featured',
                  loop: section.settings.enable_video_looping,
                  modal_id: section.id,
                  xr_button: false,
                  media_width: media_width,
                  media_fit: section.settings.media_fit,
                  constrain_to_viewport: section.settings.constrain_to_viewport
                %}
              </div>
            {%- endif -%}
            {%- liquid
              assign media_to_render = product.featured_media.id
              for variant in product.variants
                assign media_to_render = media_to_render | append: variant.featured_media.id | append: ' '
              endfor
            -%}
            {%- for media in product.media -%}
              {%- if media_to_render contains media.id
                and media.id != product.selected_or_first_available_variant.featured_media.id
              -%}
                <div class="product__media-item" data-media-id="{{ section.id }}-{{ media.id }}">
                {% comment %}  {% render 'product-thumbnail',
                    media: media,
                    position: forloop.index,
                    loop: section.settings.enable_video_looping,
                    modal_id: section.id,
                    xr_button: false,
                    media_width: media_width,
                    media_fit: section.settings.media_fit,
                    constrain_to_viewport: section.settings.constrain_to_viewport
                  %} {% endcomment %}

                {% comment %}   <div class="banner-slider">
                      <div class="slider-forss">
                          {% for block in section.blocks %}
                            {% if block.settings.media_image != blank %}
                              <a href="{{ block.settings.media_image | img_url: 'master' }}" class="item-slick">
                               <img src="{{ block.settings.media_image | img_url: 'master' }}" alt="Alt" />
                              </a>
                            {% endif %}
                          {% endfor %}
                      </div>
                     
                        <div class="slider-navss">
                            
                            {% for block in section.blocks %}
                                  {% if block.settings.media_image != blank %}
                            <div class="item-slick">        <img src="{{ block.settings.media_image | img_url: 'master' }}" alt="Alt"> </div> 
                                  {% endif %}
                              {% endfor %}
                            
                         
                        </div>
                   </div> {% endcomment %}

                    <div class="banner-slider">
                      <div class="slider-forss">
                        {% for media in product.media %}
                        {% case media.media_type %}
                        {% when 'image' %}
        
                        <a href="{{ media | img_url: 'master' }}" class="item-slick">
        
                          <img src="{{ media | img_url: '800x800' }}" alt="Alt">
        
                        </a>
                        {% when 'video' %}
                        <div class="product-single__video myclass">
                          {{ media | video_tag:  controls: true, autoplay: false }}
                        </div>
        
                        {% endcase %}
        
                        {% endfor %}
        
                      </div>
                     
                        <div class="slider-navss">
                          {% for media in product.media %}
                          {% case media.media_type %}
                          {% when 'image' %}
          
                          <div class="item-slick"><img src="{{ media | img_url: '150x150' }}" alt="Alt"></div>
          
                          {% when 'video' %}
          
                          <img src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/sakoon_yellow_square_logo_aa64137e-47f7-4890-a8ac-0dafac908eb4.png?v=1642501474" >
          
          
                          {% endcase %}
          
                          {% endfor %}
                        </div>
                   </div>

                  
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if first_3d_model -%}
            <button
              class="button button--full-width product__xr-button"
              type="button"
              aria-label="{{ 'products.product.xr_button_label' | t }}"
              data-shopify-xr
              data-shopify-model3d-id="{{ first_3d_model.id }}"
              data-shopify-title="{{ product.title | escape }}"
              data-shopify-xr-hidden
            >
              {% render 'icon-3d-model' %}
              {{ 'products.product.xr_button' | t }}
            </button>
          {%- endif -%}
        </media-gallery>

        <section class="d-none d-md-block" id="main_faq">
             <div class="accoblock">         
                {% for block in section.blocks %}
                  {% if block.settings.faq_title != blank %}
                    <div class="acctitle">
                      <a href="javascript:void(0);">{{ block.settings.faq_title }} <span class="accicon plus"></span></a>
                      <div class="acccontent">
                        <p>{{ block.settings.faq_content }}</p>
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
            </div>
        </section>
        
      </div>
      
      <div class="product__info-wrapper grid__item">
        <product-info
          id="ProductInfo-{{ section.id }}"
          class="product__info-container"
          data-section="{{ section.id }}"
          data-url="{{ product.url }}"
        >
          {%- assign product_form_id = 'product-form-' | append: section.id -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {%- when 'text' -%}
                <!-- <p
                  class="product__text{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.text -}}
                </p> -->
              <div class="loox-rating" data-id="{{ product.id }}" data-rating="{{ product.metafields.loox.avg_rating }}" data-raters="{{ product.metafields.loox.num_reviews }}"data-pattern="[rating]/5, [count] Reviews"></div>
              {%- when 'title' -%}
                <h2 class="product__title aa {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                  {%- if product.title != blank -%}
                    {{ product.title | escape }}
                  {%- else -%}
                    {{ 'onboarding.product_title' | t }}
                  {%- endif -%}
                </h2>

                <div class="productdesc">{{ section.settings.product_description }}</div> 
               {% comment %} <div class="productdesc">{{ product.description }}</div> {% endcomment %}
              

                <div class="free_shipping">
                  {% if section.settings.bestseller_title != blank %}
                    <div class="bestsellerbadge">
                     <img src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/crown.svg?v=1710959473" />
                     <h5 class="mb-0 ml-1"> {{ section.settings.bestseller_title }}</h5>
                   </div>
                  {% endif %}

                   {% if section.settings.bestseller_title != blank %}
                   <div class="free_shippingbadge">
                    <span class="shippingicon"></span>
                     <p class="">{{ section.settings.free_title }}</p>
                   </div>
                   {% endif %}
                  
                </div>

               {% comment %} <div class="nav-tabs-outer">
                <ul class="nav nav-tabs js-tabs">
                  {% for block in section.blocks %}
                    {% if block.settings.tab_title != blank %}
                      <li class="text-center {% if forloop.index == 1 %}active{% endif %}">
                        <a href="#tab{{ forloop.index }}" data-toggle="tab">{{ block.settings.tab_title }}</a>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
                <div class="tab-content">
                  {% for block in section.blocks %}
                    {% if block.settings.tab_content != blank %}
                      <div id="tab{{ forloop.index }}" role="tabpanel" class="tab-pane {% if forloop.index == 1 %}active{% endif %} fade in">
                        {{ block.settings.tab_content }}
                        {{ block.settings.tab_details }}
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              </div> {% endcomment %}

          <div class="main_key_benefit">
              {% assign counter = 0 %}
              <div class="tabmenublock">
                {% for block in section.blocks %}
                  {% if block.settings.tab_title != blank %}
                    {% assign counter = counter | plus: 1 %}
                    <div class="tabmenu">
                      <div class="tab_title {% if counter == 1 %}active{% endif %}" data-index="tab-{{ counter }}">{{ block.settings.tab_title }} {{ block.settings.tab_review }}</div>
                    </div>
                  {% endif %}
                  {% endfor %}
              </div>

              <div class="tabcontent">
                <div class="tab_content_data benifit_content active" data-index="tab-1">
                    {% for block in section.blocks %}
                      {% if block.settings.tab_benifit != blank %}
                       <h4 class="benifit_title">{{ block.settings.tab_benifit }}</h4>
                       <div class="benifitscontent">{{ block.settings.tab_benifit_content }}</div>
                       {% endif %}
                    {% endfor %}
                </div>
                <div class="tab_content_data tab_review_details" data-index="tab-2">
                  
                   {% for block in section.blocks %}
                     {% if block.settings.review_img != blank %}
                         <div class="review_img"><img src="{{ block.settings.review_img | img_url: 'master' }}"></div>
                      {% endif %} 
                      {% if block.settings.tab_review_title != blank %}
                         <h4 class="review_title">{{ block.settings.tab_review_title }}</h4>
                      {% endif %} 
                   {% endfor %}
                     {% assign counters = 0 %}   
                      {% assign counters = counters | plus: 1 %}
                      <div class="position-relative">
                        <div class="tab_review" data-index="tab-{{ counters }}">
                        {% for block in section.blocks %}
                          {% if block.settings.tab_review != blank %}
                          <div class="tabslidebox text-center">
                              <div class="reviewslideblock">
                                <img src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/review_quote.svg?v=1710841963" class="slidequote">
                                <p class="review_content">{{ block.settings.review_content }}</p>
                                <p class="review_title"> <img src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/ver-icon.svg" class="reviewvericon" /> {{ block.settings.tab_review }}</p>
                              </div>
                            </div>
                          {% endif %}
                        {% endfor %}
                      </div>             
                    <div class="sliderarrows">
                      <a href="javascript:void(0);" class="productreviewprev prev">
                        <img src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/left-arrow.svg" />
                      </a>
                      <div class="slick-slider-dots productreview-slider-dots"></div>
                      <a href="javascript:void(0);" class="productreviewnext next">
                        <img src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/right-arrow.svg" />
                      </a>
                    </div>
                      </div>   

                    <section class="tab_img_ticker">
                      <div class="img_ticker_row col">
                          <div class="tickerslide d-flex">
                            {% for block in section.blocks %}
                              {% if block.settings.image != blank %}
                              <div class="tickerimg_box">
                                  <img src="{{ block.settings.image | img_url: 'master' }}" alt="">
                              </div>
                            {% endif %}
                              {% endfor %}
                            {% for block in section.blocks %}
                              {% if block.settings.image != blank %}
                              <div class="tickerimg_box">
                                  <img src="{{ block.settings.image | img_url: 'master' }}" alt="">
                              </div>
                            {% endif %}
                              {% endfor %}
                          </div>
                      </div>
                    </section>

                  
                </div>
                <div class="tab_content_data integration" data-index="tab-3">
                   {% for block in section.blocks %}
                     {% if block.settings.integration_main_title != blank %}
                       <h2>{{ block.settings.integration_main_title }}</h2>
                      {% endif %}
                    {% endfor %}
                  <div class="row">
                    {% for block in section.blocks %}
                      {% if block.settings.integration_icon != blank or block.settings.integration_title != blank %}
                        <div class="col-4">
                          <div class="ingredientsbox text-center">
                            {% if block.settings.integration_icon != blank %}
                              <div class="ingredientsiconbox">
                                <img src="{{ block.settings.integration_icon | img_url: 'master' }}" alt="Integration Icon" />
                              </div>
                            {% endif %}
                            {% if block.settings.integration_title != blank %}
                              <div class="ingredientsdesc">{{ block.settings.integration_title }}</div>
                            {% endif %}
