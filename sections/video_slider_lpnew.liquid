
{%- style -%}
  
{% if section.settings.bg != blank %}
    .section_bg_{{ section.id }} {
      background-image:url({{section.settings.bg | image_url}});
    background-size: cover;
    background-attachment: unset;
    background-repeat: no-repeat;
    background-position: bottom;
    } 
  {% endif %}
{% if section.settings.bg_mobile != blank %}
  @media screen and (max-width: 750px) {
    .section_bg_{{ section.id }} {
      background-image:url({{section.settings.bg_mobile | image_url}});
    }
  }
  {% endif %}
  @media screen and (max-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% if section.settings.svg_desktop != blank %}
  <div class="desktop_only curve_top {{ section.settings.custom_class }}">{{ section.settings.svg_desktop }}</div>
  {% endif %}
  {% if section.settings.svg_mobile != blank %}
  <div class="mobile_only curve_top {{ section.settings.custom_class }}">{{ section.settings.svg_mobile }}</div>
  {% endif %}

<div class="video_slider_custom section_bg_{{ section.id }} {{ section.settings.custom_class }}"{% if section.settings.custom_id != blank %} id="{{ section.settings.custom_id }}"{% endif %}
style="background-color:{{ section.settings.bg_color | default:'transparent' }}">
   <div class="container_hk section-{{ section.id }}-padding isolate">
   

       {% if section.settings.heading != blank %}
<div class="videos_top_slider">
      <h2 class="rich-text__heading  inline-richtext h1">{{ section.settings.heading }}</h2>
     </div>
       {% if section.settings.subheading != blank %}
      <div class="video_slider_subheading">{{ section.settings.subheading }}</div>
       {% endif %}
       {% endif %}

     <div class="videos_center left">
       <div class="videos_slider_main slider_{{ section.id }}">
        {%- for block in section.blocks -%}
              {%- if block.settings.video != blank -%}
       <div class="videos_slider_item">
          <div class="video_wrapper_custom">
            {{ block.settings.video | media_tag: image_size: "master", autoplay: false, loop: true, controls: true, preload: "true", class:"video_paused_custom" }}
            {% if  block.settings.image != blank %}
           <img src="{{ block.settings.image | image_url }}" width="auto" height="auto" loading="lazy" alt="{{ block.settings.image.alt }}" class="trigger_video_play_js trigger_video_play_css">
            {% else %}
              <img src="{{ block.settings.video.preview_image | image_url }}" width="auto" height="auto" loading="lazy" alt="video" class="trigger_video_play_js trigger_video_play_css">
           
              {% endif %}
             <div class="custom_button">
                <span>
<svg xmlns="http://www.w3.org/2000/svg" width="21" height="24" viewBox="0 0 21 24" fill="none">
  <path d="M19.619 13.7518L3.6151 23.0377C2.25692 23.825 0.513916 22.8717 0.513916 21.2847V2.71281C0.513916 1.12826 2.2544 0.172502 3.6151 0.96226L19.619 10.2482C19.928 10.4246 20.1848 10.6795 20.3634 10.9872C20.542 11.2948 20.6361 11.6442 20.6361 12C20.6361 12.3558 20.542 12.7052 20.3634 13.0128C20.1848 13.3205 19.928 13.5754 19.619 13.7518Z" fill="white"/>
</svg></span>
                </div>
                </div>
          {% if block.settings.text != blank %}
            <div class="video_text_slider_new">{{ block.settings.text }}
              {% if block.settings.richtext != blank %}{{ block.settings.richtext }}{% endif %}
            </div>
            {% endif %}
           </div>
        
              {%- endif -%}
       {% endfor %}
       </div>
     </div>
        <div class="slider_navigations center{% if section.blocks.size < 6 %} {% endif %}">
  <div class="slider_button_custom custom_prev prev_{{ section.id }}"><svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 34 34" fill="none">
  <circle cx="17" cy="17" r="17" transform="matrix(-1 0 0 1 34 0)" fill="#CEE2F5"/>
  <path d="M11.2928 17.7071C10.9023 17.3166 10.9023 16.6834 11.2928 16.2929L17.6568 9.92893C18.0473 9.53841 18.6804 9.53841 19.071 9.92893C19.4615 10.3195 19.4615 10.9526 19.071 11.3431L13.4141 17L19.071 22.6569C19.4615 23.0474 19.4615 23.6805 19.071 24.0711C18.6804 24.4616 18.0473 24.4616 17.6568 24.0711L11.2928 17.7071ZM12 17V18H11.9999V17V16H12V17Z" fill="white"/>
</svg></div>
       <div class="slider_dots_custom custom_next dots_{{ section.id }}"></div>
  <div class="slider_button_custom next_{{ section.id }}"><svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 34 34" fill="none">
  <circle cx="17" cy="17" r="17" fill="#1F6CA5"/>
  <path d="M22.7072 17.7071C23.0977 17.3166 23.0977 16.6834 22.7072 16.2929L16.3432 9.92893C15.9527 9.53841 15.3196 9.53841 14.929 9.92893C14.5385 10.3195 14.5385 10.9526 14.929 11.3431L20.5859 17L14.929 22.6569C14.5385 23.0474 14.5385 23.6805 14.929 24.0711C15.3196 24.4616 15.9527 24.4616 16.3432 24.0711L22.7072 17.7071ZM22 17V18H22.0001V17V16H22V17Z" fill="white"/>
</svg></div>
     </div>
     
   </div>
  </div>

<script>
    $('.slider_{{ section.id }}').slick({
  dots: true,
  speed: 300,
  slidesToShow: 5,
  slidesToScroll: 1,
  autoplay: false,
  infinite: true,
  centerMode: false,
  centerPadding: '0px',
  cssEase:'linear',
    prevArrow: $('.prev_{{ section.id }}'),
    nextArrow: $('.next_{{ section.id }}'),
    appendDots: $('.dots_{{ section.id }}'),
  responsive: [
    {
      breakpoint: 915,
      settings: {
        slidesToShow:1, 
        slidesToScroll: 1
      }
    }
  ]
});
  
</script>

    {% if section.settings.svg_desktop2 != blank %}
  <div class="desktop_only curve_bottom {{ section.settings.custom_class }}">{{ section.settings.svg_desktop2 }}</div>
  {% endif %}
  {% if section.settings.svg_mobile2 != blank %}
  <div class="mobile_only curve_bottom {{ section.settings.custom_class }}">{{ section.settings.svg_mobile2 }}</div>
  {% endif %}

{% schema %}
  {
    "name": "Video Slider new",
    "settings": [
     {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    },
      {
      "type": "image_picker",
      "id": "bg",
      "label": "Section Background"
    },
      {
      "type": "image_picker",
      "id": "bg_mobile",
      "label": "Section Background"
    },
     {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color"
    },
     {
      "type": "liquid",
      "id": "svg_desktop",
      "label": "Curve Top Desktop"
    },
     {
      "type": "liquid",
      "id": "svg_mobile",
      "label": "Curve Top Mobile"
    },
     {
      "type": "liquid",
      "id": "svg_desktop2",
      "label": "Curve Bottom Desktop"
    },
     {
      "type": "liquid",
      "id": "svg_mobile2",
      "label": "Curve Bottom Mobile"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "SubHeading"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top Desktop",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom Desktop",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 50
    }
    ],
  "blocks": [
     {
      "type": "video",
      "name": "Video",
      "settings": [
         {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Poster"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "richtext",
          "id": "richtext",
          "label": "RichText"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Slider new"
    }
  ]
  }
{% endschema %}