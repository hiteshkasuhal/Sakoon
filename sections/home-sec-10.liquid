
<div class="sec9_home">
  <div class="sec9_home_left">
    <h2> {{ section.settings.heading }} </h2>
    <p> {{ section.settings.subheading }} </p>
    <button onclick="window.location='{{ section.settings.btn-link }}'" > {{ section.settings.btn-text }} </button>
  </div>
  <div class="sec9_home_right">
    <div class="sec9_home_slider">
      
      {% for article in blogs[section.settings.blog].articles limit:4 %}
      <div class="sec9_home_slider_ele">
        <div class="sec9_home_flx_inner">
          <a href="{{ article.url }}">
          <img src="{{ article.image | img_url:'540x' }}">
            </a>
          <h6 onclick="window.location='{{ article.url }}'"> {{ article.title }} </h6>
          <p> {{ article.excerpt }} </p>
        </div>
      </div>
      {% endfor %}
      
     
      
    </div>
  </div>
</div>



{% schema %}
  {
    "name": "Blogs",
    "settings": [
                  {
                   "type":"text",
                   "id":"heading",
                   "label":"Heading"
                 },
                 {
                   "type":"textarea",
                   "id":"subheading",
                   "label":"Subheading"
                 },
                 {
                   "type":"text",
                   "id":"btn-text",
                   "label":"Button Text"
                 },
                 {
                   "type":"url",
                   "id":"btn-link",
                   "label":"Button Link"
                 },
                 {
                   "type":"blog",
                   "id":"blog",
                   "label":"Select Blog"
                 }
                ],
    "presets":[{
                 "name":"Blogs",
                 "category":"custom"
              }]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
