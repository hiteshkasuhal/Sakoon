<div class="sec1_home sec1_loctaion sec1_contact">
  <img src=" {{ section.settings.bg | image_url }} " width="100%" class="desktop_item" alt="{{ section.settings.bg.alt }}" loading="lazy" fetchpriority="low"  height="auto">

  <div class="sec1_contact_inner sec1_loctaion">
      <h1> {{ section.settings.heading }} </h1>
      <p> {{ section.settings.subheading }} </p>
  </div>
</div>
 
<div class="sec2_contact sec2_location">
  <div class="sec2_location_left">
    <img src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/img20.png?v=1641222746" width="100%" alt="Map Image" loading="lazy" fetchpriority="low"  height="auto">
  </div>
  <div class="sec2_location_right">
    <h2> {{ section.settings.location }} </h2>
{% for block in section.blocks %}
  {% if block.settings.country != blank %}
    <h5> {{  block.settings.country }} </h5>
    {% endif %}
  {% if block.settings.state != blank %}
    <h6> {{ block.settings.state }} </h6>
    {% endif %}
  {% if block.settings.info != blank %}
     {{ block.settings.info }}
    {% endif %}
    
 {% endfor %}

 


  </div>
</div>



{% schema %}
  {
    "name": "Location",
    "settings": [
                 {
                   "type":"image_picker",
                   "id":"bg",
                   "label":"Background Image"
                 },
                 {
                   "type":"text",
                   "id":"heading",
                   "label":"Heading"
                 },
                 {
                   "type":"textarea",
                   "id":"subheading",
                   "label":"Subheading"
                 },
                 {
                   "type":"text",
                   "id":"location",
                   "label":"Location Heading"
                 }
                
             ],
   "blocks":[
              {
                 "type":"location",
                 "name":"location",
                 "settings":[
                             {
                               "type":"text",
                               "id":"country",
                               "label":"Country Name"
                             },
                             {
                               "type":"text",
                               "id":"state",
                               "label":"State Name"
                             },
                             {
                               "type":"richtext",
                               "id":"info",
                               "label":"Address Info"
                             }
                            ]
              }
            ],
    "presets":[
      {
        "name":"Location Page"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
