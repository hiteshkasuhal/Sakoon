$(document)
  .off("click", ".trigger_{{ section.id }}")
  .on("click", ".trigger_{{ section.id }}", function(e) {

    e.preventDefault();
    e.stopImmediatePropagation();

    var $btn = $(this);

    // 🚫 prevent double firing
    if ($btn.hasClass("loading_hk")) return;

    $btn.addClass("loading_hk");

    var id = $btn.attr("variant_id"),
        quantity = $btn.attr("quantity") || 1,
        selling_plan = $btn.attr("selling_plan");

    var data = {
      id: id,
      quantity: parseInt(quantity, 10)
    };

    if (selling_plan) {
      data.selling_plan = parseInt(selling_plan, 10);
    }

    $.ajax({
      type: "POST",
      url: "/cart/add.js",
      data: data,
      dataType: "json",
      success: function () {
          window.upcartRefreshCart();
            window.upcartOpenCart();
      },
      complete: function () {
        setTimeout(function(){
          $btn.removeClass("loading_hk");
        }, 300);
      },
      error: function () {
        $btn.removeClass("loading_hk");
        alert("Error adding to cart.");
      }
    });

});


$(document).on("click", '.option_item', function(e) { 
$(this).parents('.options_flex').find('.option_item').removeClass('active');  
$(this).addClass('active');   
var selected_tab = $('.subscription_item.active').attr('data_tab');
var variant_id = $(this).attr('variant_id');
if (selected_tab == '2'){
var selling_plan = $('.option_item.active').attr('selling_plan');
$('.trigger_{{ section.id }}').attr('selling_plan',selling_plan);
} else {
$('.trigger_{{ section.id }}').removeAttr('selling_plan');
}
$('.trigger_{{ section.id }}').attr('variant_id',variant_id);
$('.variant_trigger').hide().removeClass('active');
$('.variant_trigger[data_tab="'+variant_id+'"]').show().addClass('active');
});


    

$(document).on("click", '.quantity_item', function(e) {  
$('.quantity_item').removeClass('active');
$(this).addClass('active');  
var quantity = $(this).attr('quantity');
var data_tab = $(this).attr('data_tab');
$('.trigger_{{ section.id }}').attr('quantity',quantity);
$('.quantity_trigger').hide().removeClass('active');
$('.quantity_trigger[data_tab="'+data_tab+'"]').show();
var selected_tab = $('.subscription_item.active').attr('data_tab');


});
    
