{%- style -%}
  .happy-customers-sec {
    padding-top: {{ section.settings.padding_top | times: 0.41 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.41 | round: 0 }}px;
    overflow:hidden;
  }
  
   @media screen and (min-width: 767px) {
    .happy-customers-sec {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
  }
 
  @media screen and (min-width: 1024px) {
    .happy-customers-sec {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  
  .happy-customers-sec .sec-head {
    margin-bottom: 95px;
    gap: 25px;
  }
  img.ratingimg {
    max-width: 237px;
      margin-left: auto;
      margin-right: auto;
  }
  .tickerslide  img {
    width: 146px;
    height: 208px;
    object-fit: cover;
  }
  .tickerslide .tickerimg_box {
      padding: 4px;
  }
  .tickerslide {
      animation: 25s slides infinite linear;
  }
  .scroll_right .tickerslide{
    animation: 30s slides-right infinite linear;
  }
  @keyframes slides {
    0% {
      transform:translate(0)
    } 
    to {
      transform:translate(-100%)
    }
  }
  @keyframes slides-right {
    0% { 
      transform:translate(-100%) 
    }
    to {
      transform:translate(0)
    }
  }

  .slidebox {
    border: 2px solid #000000;
    background: #fff;
    padding: 25px;
    text-align: center;
    border-radius: 9px;
    position: relative;
    height: 100%;
    display: flex !important;
    flex-direction: column;
    align-items: center;
  }
  .review_slider .slick-track {
      display: flex;
  }
  .review_slider .slick-track .slick-slide {
      height: auto;
      padding: 0 15px;
  }
  .slidebox p {
      font-size: 20px;
      line-height: 24px;
      font-weight: 500;
      margin-bottom:25px
  }
  .verblock {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: auto;
  }
  .verblock span {
      font-size: 17px;
      font-weight: 600;
      margin-left: 6px;
  }
  .slidebox .slidequote {
      width: 37px;
      position: absolute;
      top: -20px;
  }
  .imgtickerblock {
      margin-bottom: 30px;
  }
  .review_slider .slick-track .slick-slide > div {
      height: 100%;
  }
  .customersreviewsblock .review_slider {
      margin-bottom: 100px;
  }
  
  @media screen and (max-width: 991px) {
    .happy-customers-sec .sec-head {
      margin-bottom: 27px;
      gap: 10px;
    }
  }
  @media screen and (max-width: 767px) {
    .happy-customers-sec .sec-head {
        margin-bottom: 31px;
        gap: 8px;
    }
    img.ratingimg {
      max-width: 136px;
    }
    .tickerslide img {
        width: 73px;
        height: 104px;
    }
    .tickerslide .tickerimg_box {
        padding: 2px;
    }
    .slidebox p {
        line-height: 20px;
        font-size: 14px;
        margin-bottom: 20px;
    }
    .verblock span {
        font-size: 12px;
    }
    .slidebox p {
        line-height: 20px;
        font-size: 14px;
        margin-bottom: 20px;
    }
    .verblock span {
        font-size: 12px;
    }
    .customersreviewsblock {
        position: relative;
    }
  }
{%- endstyle -%}


<!-- --------------------- Happy Customers Section --------------------- -->
<section class="happy-customers-sec" style="background-color:{{section.settings.bgcolor}};color:{{section.settings.textcolor}};">
  <div class="container-fluid p-0">
    {% if section.settings.secheading != blank %}
    <div class="sec-head d-flex flex-column text-center">
      <img loading="lazy" src="{{ section.settings.ratingstgar | image_url }}" class="img-fluid ratingimg"  alt="Rating Stars" width="auto" height="auto" loading="lazy" fetchpriority="low">
      <h2 class="sec-title">{{section.settings.secheading}}</h2>
    </div>
    {% endif %}
    <div class="sec_content">
      <div class="imgtickerblock">
        <div class="img_ticker_row  d-flex">
          <div class="tickerslide d-flex">
            {% for block in section.blocks %}
              {% if block.settings.image != blank %}
                <div class="tickerimg_box">
                    <img src="{{ block.settings.image | image_url }}" alt="Ticker Image" width="auto" height="auto" loading="lazy" fetchpriority="low">
                </div>
              {% endif %}
            {% endfor %}
          </div>
          <div class="tickerslide d-flex">
            {% for block in section.blocks %}
              {% if block.settings.image != blank %}
                <div class="tickerimg_box">
                    <img loading="lazy" src="{{ block.settings.image | image_url }}"  alt="Ticker Image" width="auto" height="auto" loading="lazy" fetchpriority="low">
                </div>
              {% endif %}
            {% endfor %}
          </div>
          <div class="tickerslide d-flex">
            {% for block in section.blocks %}
              {% if block.settings.image != blank %}
                <div class="tickerimg_box">
                    <img loading="lazy" src="{{ block.settings.image | image_url }}"  alt="Ticker Image" width="auto" height="auto" loading="lazy" fetchpriority="low">
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        <div class="img_ticker_row scroll_right d-md-none d-flex">
          <div class="tickerslide d-flex">
              {% for block in section.blocks %}
                {% if block.settings.image_right != blank %}
                  <div class="tickerimg_box">
                      <img loading="lazy" src="{{ block.settings.image_right | image_url }}" alt="Ticker Image" width="auto" height="auto" loading="lazy" fetchpriority="low">
                  </div>
                {% endif %}
              {% endfor %}
          </div>
          <div class="tickerslide d-flex">
            {% for block in section.blocks %}
              {% if block.settings.image_right != blank %}
                <div class="tickerimg_box">
                    <img src="{{ block.settings.image_right | image_url }}" alt="{{ block.settings.image_right.alt }}" width="auto" height="auto" loading="lazy">
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
      <div class="customerreviewrow">
        
        <div class="customersreviewsblock">
          <div class="review_slider customerreview_slider">
            {% for block in section.blocks %}
                {% if block.settings.reviewtxt != blank %}
                    <div class="customerreviewslide">
                      <div class="slidebox">
                        {% if template.suffix == 'shilajit-new' %}
                        <img src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/quotes.png?v=1715069539" class="slidequote" alt="slidequote" width="auto" height="auto" loading="lazy" />
                        {% elsif  template.suffix == 'honey_capsules' %}
                        <img src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/fi_11042702.png?v=1722688372" class="slidequote" alt="slidequote" width="auto" height="auto" loading="lazy" />
                        {% else %}
                        <img src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/fi_11042702.svg?v=1712647450" class="slidequote" alt="slidequote" width="auto" height="auto" loading="lazy" />
                        {% endif %}
                        <p>{{ block.settings.reviewtxt }}</p>
                        <div class="verblock">
                          
                        {% if template.suffix == 'bloating-relief' %}
                          <span class="verified_custom">
                          <img src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/Group_1000004398.svg?v=1712647450" alt="verified" width="auto" height="auto" loading="lazy" >
                          <span> {{ block.settings.customername }}</span>
                          </span>
                          {% else %}
                          <span>- {{ block.settings.customername }}</span>
                          <span class="verified_custom">
                        {% if template.suffix == 'shilajit-new' %}
                          <img src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/verifies.png?v=1715069538" alt="verified" width="auto" height="auto" loading="lazy" >
                        {% elsif template.suffix == 'honey_capsules' %}
                          <img src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/ver-icon.svg" width="auto" alt="verified" height="auto" loading="lazy" >
                        {% else %}
                          <img src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/Group_1000004398.svg?v=1712647450" alt="verified" width="auto" height="auto" loading="lazy" >
                        {% endif %}Verified Customer
                          </span>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                {% endif %}
              {% endfor %}
          </div>
          <div class="sliderarrows">
            <a href="javascript:void(0);" class="customerprev prev"><img loading="lazy" src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/left-arrow.svg"  alt="Slide Previous" width="auto" height="auto" loading="lazy" fetchpriority="low"/><span style="display:none;">Slide Previous</span></a>
            <div class="customer-slider-dots slick-slider-dots"></div>
            <a href="javascript:void(0);" class="customernext next"><img loading="lazy" src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/right-arrow.svg"  alt="Slide Next" width="auto" height="auto" loading="lazy" fetchpriority="low"/><span style="display:none;">Slide Next</span></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Happy Customers Section",
    "settings": [      
      {
        "type": "color",
        "id": "bgcolor",
        "label": "Background Color"
      },
      {
        "type": "color",
        "id": "textcolor",
        "label": "Text Color"
      },
      {
        "type": "html",
        "id": "secheading",
        "label": "Section Heading"
      },
      {
        "type": "image_picker",
        "id": "ratingstgar",
        "label": "Rating Star Image"
      },
      {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
    ],
    "blocks": [
      {
        "type": "Image",
        "name": "Image",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          }
        ]
      },
       {
        "type": "ImageRight",
        "name": "Image Right",
        "settings": [
          {
            "type": "image_picker",
            "id": "image_right",
            "label": "Image"
          }
        ]
      },
      {
        "type": "Video",
        "name": "Review Block",
        "settings": [
          {
            "type": "textarea",
            "id": "reviewtxt",
            "label": "Review Text"
          },
          {
            "type": "text",
            "id": "customername",
            "label": "Customer Name"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Happy Customers Section",
        "category": "Happy Customers Section"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

<script type="text/javascript">
  $(document).ready(function(){
    $('.customerreview_slider').slick({
    dots: true,
    arrows: true,
    infinite: true,
    slidesToShow: 4,
    centerMode: true,
    slidesToScroll: 1,
    prevArrow: $('.customerprev'),
    nextArrow: $('.customernext'),
    appendDots: $('.customer-slider-dots'),
    responsive: [
      {
      breakpoint: 991,
        settings: {
          slidesToShow: 2,
          slidesToScroll: 1,
          centerMode: false
        }
      },
      {
        breakpoint: 767,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1,
            centerMode: false
          }
      }
    ]
    });
  });
</script>

{% javascript %}
{% endjavascript %}

