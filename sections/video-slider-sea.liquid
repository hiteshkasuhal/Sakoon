      "label": "Section Background Color"
    },
    {
      "type": "liquid",
      "id": "html",
      "label": "Html"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text"
    },
