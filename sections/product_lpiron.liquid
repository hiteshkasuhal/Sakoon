$(function () {

  var $slider = $('.slider_{{ section.id }}');

  // When image inside slider is clicked
  $slider.on('click', 'img', function () {

    var items = [];

    // Collect all real (non-cloned) slide images
    $slider.find('.slick-slide:not(.slick-cloned) img').each(function () {

      var largeSrc = $(this).attr('data-large') || $(this).attr('src');

      items.push({
        src: largeSrc,
        type: 'image'
      });

    });

    // Get current slick index
    var currentIndex = $slider.slick('slickCurrentSlide');

    $.magnificPopup.open({
      items: items,
      type: 'image',
      gallery: {
        enabled: true
      },
      mainClass: 'mfp-zoom-in mfp-img-mobile',
      image: {
        verticalFit: true
      }
    }, currentIndex);

  });

});
</script>




