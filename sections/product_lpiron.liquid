$(document).on("click", '.trigger_{{ section.id }}', function(e) {
  e.preventDefault();
  var $btn = $(this).addClass('loading_hk'),
      id = $btn.attr('variant_id'),
      quantity = $btn.attr('quantity'),
      selling_plan = $btn.attr('selling_plan'),
      data = { id: id, quantity: quantity };

  if (selling_plan) data.selling_plan = selling_plan;

  $.post('/cart/add.js', data, function () { 
$btn.removeClass('loading_hk');
    // Update cart bubble only
    $.getJSON("/cart.js", function(cart) {
      var count = cart.item_count;

      $("a#cart-icon-bubble, a#cart-icon-bubble-mob")
        .find(".cart-count, .count, span")
        .text(count);
    });
   //location.href = '/checkout';
  }, 'json');
});

$(document).on("click", ".js_{{ section.id }} .option_item", function (e) {

  var $section = $(".js_{{ section.id }}");

  /* -----------------------------
     ACTIVE STATE (PER GROUP)
  ----------------------------- */
  $(this)
    .closest(".options_flex")
    .find(".option_item")
    .removeClass("active");

  $(this).addClass("active");

  /* -----------------------------
     COLLECT ALL SELECTED VALUES
  ----------------------------- */
  var selectedValues = [];

  $section.find(".options_flex").each(function () {
    var value = $(this).find(".option_item.active").attr("variant_title");
    if (value) selectedValues.push($.trim(value));
  });
  /* -----------------------------
     MATCH AGAINST SELECT OPTIONS
  ----------------------------- */
  var $select = $section.find('select[name="variants_id"]');
  var matchedVariantId = null;

  $select.find("option").each(function () {

    var variantTitle = $(this).text().split(" / ");
    var isMatch = true;

    for (var i = 0; i < selectedValues.length; i++) {
      if ($.trim(variantTitle[i]) !== selectedValues[i]) {
        isMatch = false;
        break;
      }
    }

    if (isMatch) {
      matchedVariantId = $(this).val();
      $select.val(matchedVariantId);
      return false; // break loop
    }

  });
  if (!matchedVariantId) return; // no variant found

  /* -----------------------------
     FETCH SELECTED OPTION DATA
  ----------------------------- */
  var $selectedOption = $select.find("option:selected");

  var variant_id = $selectedOption.val();
  var selling_plan = $('.sub_flex_bottom_delivery_item.active').attr("selling_plan");

  /* -----------------------------
     YOUR ORIGINAL LOGIC
  ----------------------------- */

  var selected_tab = $section.find(".subscription_item.active").attr("data_tab");

  if (selected_tab == "2" && selling_plan) {
    $(".trigger_{{ section.id }}").attr("selling_plan", selling_plan);
  } else {
    $(".trigger_{{ section.id }}").removeAttr("selling_plan");
  }

  $(".trigger_{{ section.id }}").attr("variant_id", variant_id);

  $section.find(".variant_trigger").hide().removeClass("active");

  $section
    .find('.variant_trigger[data_tab="' + variant_id + '"]')
    .show()
    .addClass("active");

});

    

