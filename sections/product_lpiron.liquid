<script>
function isAnyElementInViewport(selectors) {
  return selectors.some(function(selector) {
    var $el = $(selector);
    return $el.is(':visible') &&
      $(window).scrollTop() + $(window).height() > $el.offset().top &&
      $(window).scrollTop() < $el.offset().top + $el.outerHeight();
  });
}
$(window).on('scroll resize', function () {
  if (!isAnyElementInViewport(['.custom_checkout_button', '.product_title_lp', '.option_item','.subscription_new_box_inner', '.product_images'])) {
    $('.custom_sticky_bottom').addClass('active');
  } else {
    $('.custom_sticky_bottom').removeClass('active');
  }
});

</script>


