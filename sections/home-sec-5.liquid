<div class="sec7_home">
  <h1> {{ section.settings.heading }} </h1>
  <p> {{ section.settings.subheading }} </p>
  <img src=" {{ section.settings.image | image_url }} " width="100%" alt="{{ section.settings.image.alt }}" loading="lazy" fetchpriority="low" width="auto" height="auto">
</div>




{% schema %}
  {
    "name": "Overlay Image With Text",
    "settings": [
                 {
                   "type":"text",
                   "id":"heading",
                   "label":"Heading"
                 },
                 {
                   "type":"textarea",
                   "id":"subheading",
                   "label":"Subheading"
                 },
                 {
                   "type":"image_picker",
                   "id":"image", 
                   "label":"Select Image"
                 }
                   
                ],
    "presets":[
                {
                  "name":"Overlay Image With Text",
                  "category":"custom"
                }
              ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

