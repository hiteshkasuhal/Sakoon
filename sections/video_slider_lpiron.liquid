
{%- style -%}
  
{% if section.settings.bg != blank %}
    .section_bg_{{ section.id }} {
      background-image:url({{section.settings.bg | image_url}});
    background-size: cover;
    background-attachment: unset;
    background-repeat: no-repeat;
    background-position: bottom;
    } 
  {% endif %}
{% if section.settings.bg_mobile != blank %}
  @media screen and (max-width: 750px) {
    .section_bg_{{ section.id }} {
      background-image:url({{section.settings.bg_mobile | image_url}});
    }
  }
  {% endif %}
  @media screen and (max-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% if section.settings.svg_desktop != blank %}
  <div class="desktop_only curve_top {{ section.settings.custom_class }}">{{ section.settings.svg_desktop }}</div>
  {% endif %}
  {% if section.settings.svg_mobile != blank %}
  <div class="mobile_only curve_top {{ section.settings.custom_class }}">{{ section.settings.svg_mobile }}</div>
  {% endif %}

<div class="video_slider_custom section_bg_{{ section.id }} {{ section.settings.custom_class }}"{% if section.settings.custom_id != blank %} id="{{ section.settings.custom_id }}"{% endif %}
style="background-color:{{ section.settings.bg_color | default:'transparent' }};color:{{ section.settings.color | default:'#000' }};">
   <div class="container_hk section-{{ section.id }}-padding isolate">
   

       {% if section.settings.heading != blank %}
<div class="videos_top_slider center">
       {% if section.settings.rating_text != blank %}
      <div class="column_slider_rating_top"><a href="#columns">{{ section.settings.rating }}
       {% if section.settings.rating_img != blank %}
            <img src="{{ section.settings.rating_img | image_url }}" width="auto" height="auto" fetchpriority="high" loading="eager" alt="{{ section.settings.rating_img.alt }}">   
       {% endif %} 
      <span>{{ section.settings.rating_text }}</span></a></div>
       {% endif %}
      <h2 class="rich-text__heading  inline-richtext h1">{{ section.settings.heading }}</h2>
     </div>
       {% if section.settings.subheading != blank %}
      <div class="video_slider_subheading">{{ section.settings.subheading }}</div>
       {% endif %}
       {% endif %}

     <div class="videos_center center">
       <div class="videos_slider_main slider_{{ section.id }} same_height_slider custom_slick_slider">
        {%- for block in section.blocks -%}
       <div class="videos_slider_item">
          <div class="video_wrapper_custom">
              {%- if block.settings.video != blank -%}
            {{ block.settings.video | media_tag: image_size: "master", autoplay: false, loop: true, controls: true, preload: "true", class:"video_paused_custom" }}
            {% if  block.settings.image != blank %}
           <img src="{{ block.settings.image | image_url }}" width="auto" height="auto" loading="lazy" alt="{{ block.settings.image.alt }}" class="trigger_video_play_js trigger_video_play_css">
            {% else %}
              <img src="{{ block.settings.video.preview_image | image_url }}" width="auto" height="auto" loading="lazy" alt="video" class="trigger_video_play_js trigger_video_play_css">
           
              {% endif %} 
            {% elsif block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url }}" width="auto" height="auto" loading="lazy" alt="{{ block.settings.image.alt }}" class="custom_poster_image">
              {% endif %}
              {%- if block.settings.video != blank -%}
             <div class="custom_button">
                <span>
<svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 50 50" fill="none">
  <ellipse cx="25.625" cy="25" rx="11.875" ry="12.5" fill="#110C00"/>
  <path fill-rule="evenodd" clip-rule="evenodd" d="M25 6.24951C35.3553 6.24951 43.75 14.6451 43.75 25.0005C43.7497 35.3556 35.3552 43.7505 25 43.7505C14.6448 43.7505 6.25026 35.3556 6.25 25.0005C6.25 14.6451 14.6447 6.24951 25 6.24951ZM21.6475 16.1929C20.3478 15.4708 18.7502 16.4102 18.75 17.897V32.1021C18.75 33.5889 20.3477 34.5292 21.6475 33.8071L34.9434 26.4204C36.0575 25.8013 36.0574 24.1988 34.9434 23.5796L21.6475 16.1929Z" fill="#FFC63B"/>
</svg></span>
                </div>
              {% endif %}
                </div>
          {% if block.settings.text != blank %}
            <div class="video_text_slider_new">{{ block.settings.text }}
            </div>
            {% endif %}
          {% if block.settings.richtext != blank %}
            <div class="video_text_slider_new">
            {% if  block.settings.image2 != blank %}
              <img src="{{ block.settings.image2 | image_url }}" width="auto" height="auto" loading="eager" fetchpriority="high" alt="{{ block.settings.image2.alt }}">
            {% endif %}
              {% if block.settings.richtext != blank %}{{ block.settings.richtext }}{% endif %}
            </div>
            {% endif %}
           </div>
        
       {% endfor %}
       </div>
       
     <div class="slider_navigations center{% if section.blocks.size < section.settings.columns_desktop %} mobile_only{% endif %}{% if section.blocks.size < 1 %} desktop_only{% endif %}">
  <div class="slider_button_custom custom_prev prev_{{ section.id }}"><svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
<foreignObject x="-8" y="-8" width="52" height="52"><div xmlns="http://www.w3.org/1999/xhtml" style="backdrop-filter:blur(4px);clip-path:url(#bgblur_0_493_214_clip_path);height:100%;width:100%"></div></foreignObject><g data-figma-bg-blur-radius="8">
<rect x="-1" y="1" width="34" height="34" rx="17" transform="matrix(-1 0 0 1 34 0)" stroke="#D69800" stroke-width="2"/>
<path d="M21.75 25.5L14.25 18L21.75 10.5" stroke="#D69800" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</g>
<defs>
<clipPath id="bgblur_0_493_214_clip_path" transform="translate(8 8)"><rect x="-1" y="1" width="34" height="34" rx="17" transform="matrix(-1 0 0 1 34 0)"/>
</clipPath></defs>
</svg></div>
       <div class="slider_dots_custom dots_{{ section.id }}"></div>
  <div class="slider_button_custom custom_next next_{{ section.id }}"><svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
<foreignObject x="-8" y="-8" width="52" height="52"><div xmlns="http://www.w3.org/1999/xhtml" style="backdrop-filter:blur(4px);clip-path:url(#bgblur_0_493_222_clip_path);height:100%;width:100%"></div></foreignObject><g data-figma-bg-blur-radius="8">
<rect x="1" y="1" width="34" height="34" rx="17" stroke="#D69800" stroke-width="2"/>
<path d="M14.25 25.5L21.75 18L14.25 10.5" stroke="#D69800" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</g>
<defs>
<clipPath id="bgblur_0_493_222_clip_path" transform="translate(8 8)"><rect x="1" y="1" width="34" height="34" rx="17"/>
</clipPath></defs>
</svg></div>
     </div>
     </div>
     
   </div>
  </div>

<script>
    $('.slider_{{ section.id }}').slick({
  dots: true,
  speed: 300,
  slidesToShow: {{ section.settings.columns_desktop }},
  slidesToScroll: 1,
  autoplay: false,
  infinite: true,
  centerMode: false,
  centerPadding: '0px',
  cssEase:'linear',
    prevArrow: $('.prev_{{ section.id }}'),
    nextArrow: $('.next_{{ section.id }}'),
    appendDots: $('.dots_{{ section.id }}'),
  responsive: [
    {
      breakpoint: 915,
      settings: {
  slidesToShow: {{ section.settings.columns_mobile }},
        slidesToScroll: 1
      }
    }
  ]
});
  
</script>

    {% if section.settings.svg_desktop2 != blank %}
  <div class="desktop_only curve_bottom {{ section.settings.custom_class }}">{{ section.settings.svg_desktop2 }}</div>
  {% endif %}
  {% if section.settings.svg_mobile2 != blank %}
  <div class="mobile_only curve_bottom {{ section.settings.custom_class }}">{{ section.settings.svg_mobile2 }}</div>
  {% endif %}

{% schema %}
  {
    "name": "Video Slider LPiron",
    "settings": [
     {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    },
      {
      "type": "image_picker",
      "id": "bg",
      "label": "Section Background"
    },
      {
      "type": "image_picker",
      "id": "bg_mobile",
      "label": "Section Background"
    },
     {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color"
    },
     {
      "type": "color",
      "id": "color",
      "label": "Section Text Color"
    },
     {
      "type": "liquid",
      "id": "svg_desktop",
      "label": "Curve Top Desktop"
    },
     {
      "type": "liquid",
      "id": "svg_mobile",
      "label": "Curve Top Mobile"
    },
     {
      "type": "liquid",
      "id": "svg_desktop2",
      "label": "Curve Bottom Desktop"
    },
     {
      "type": "liquid",
      "id": "svg_mobile2",
      "label": "Curve Bottom Mobile"
    },
    {
      "type": "liquid",
      "id": "rating",
      "label": "Rating Svg"
    },
    {
      "type": "image_picker",
      "id": "rating_img",
      "label": "Rating Img"
    },
    {
      "type": "inline_richtext",
      "id": "rating_text",
      "label": "Rating Text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "SubHeading"
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "COlumns Desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "COlumns Mobile",
      "default": 1
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top Desktop",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom Desktop",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 50
    }
    ],
  "blocks": [
     {
      "type": "video",
      "name": "Video",
      "settings": [
         {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Poster"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "richtext",
          "id": "richtext",
          "label": "RichText"
        },
        {
          "type": "image_picker",
          "id": "image2",
          "label": "Product Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Slider LPiron"
    }
  ]
  }
{% endschema %}