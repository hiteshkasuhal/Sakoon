            "html": "<div class=\"newsletter_main_html\">\n<div class=\"newsletter_form_lp\">\n {% form 'customer', class: 'newsletter-form_lp' %}\n              <input type=\"hidden\" name=\"contact[tags]\" value=\"newsletter\">\n              <div class=\"newsletter-form__field-wrapper_lp\">\n                <div class=\"field_lp\">\n                  <input\n                    id=\"NewsletterForm--{{ section.id }}\"\n                    type=\"email\"\n                    name=\"contact[email]\"\n                    class=\"field__input_lp\"\n                    value=\"{{ form.email }}\"\n                    aria-required=\"true\"\n                    autocorrect=\"off\"\n                    autocapitalize=\"off\"\n                    autocomplete=\"email\"\n                    {% if form.errors %}\n                      autofocus\n                      aria-invalid=\"true\"\n                      aria-describedby=\"Newsletter-error--{{ section.id }}\"\n                    {% elsif form.posted_successfully? %}\n                      aria-describedby=\"Newsletter-success--{{ section.id }}\"\n                    {% endif %}\n                    placeholder=\"Enter your email\"\n                    required\n                  >\n                   <button\n                    type=\"submit\"\n                    class=\"button custom_hk_button\"\n                    name=\"commit\"\n                    id=\"Subscribe\"\n                    aria-label=\"{{ 'newsletter.button_label' | t }}\"\n                  ><svg width=\"10\" height=\"16\" viewBox=\"0 0 10 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M1.3999 0.799805L8.5999 7.9998L1.3999 15.1998\" stroke=\"white\" stroke-width=\"1.44\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n</svg>\n</button>\n                </div>\n                {%- if form.errors -%}\n                  <small class=\"newsletter-form__message form__message\" id=\"Newsletter-error--{{ section.id }}\">\n                    {%- render 'icon-error' -%}\n                    {{- form.errors.translated_fields.email | capitalize }}\n                    {{ form.errors.messages.email -}}\n                  </small>\n                {%- endif -%}\n              </div>\n              {%- if form.posted_successfully? -%}\n                <h3\n                  class=\"newsletter-form__message newsletter-form__message--success form__message\"\n                  id=\"Newsletter-success--{{ section.id }}\"\n                  tabindex=\"-1\"\n                  autofocus\n                >\n                  {% render 'icon-success' -%}\n                  {{- 'newsletter.success' | t }}\n                </h3>\n              {%- endif -%}\n            {% endform %}\n</div>\n</div> \n\n\n\n<div class=\"bottom_copyright\">\n<div class=\"copyright_lp\">© {{ \"now\" | date: \"%Y\" }} Sakoon Nutrition, All Rights Reserved</div>\n<div class=\"payments_lp\">\n<img src=\"https://cdn.shopify.com/s/files/1/0296/4848/6460/files/lp_footer_brand.webp?v=1756818273\" alt=\"payments\" width=\"auto\" height=\"auto\" loading=\"eager\" fetchpriority=\"high\">\n</div>\n</div>",
