{%- style -%}
  .product-info-sec {
    padding-top: {{ section.settings.padding_top | times: 0.41 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.41 | round: 0 }}px;
  }
    
   @media screen and (min-width: 767px) {
    .product-info-sec {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
  }
 
  @media screen and (min-width: 1024px) {
    .product-info-sec {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  
  .product-info-sec .sec-head {
    margin-bottom: 100px;
    gap: 20px;
  }
  .checklistblock {
    padding: 0;
    list-style: none;
    margin: 30px 0 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .checklistblock li {
    font-size: 20px;
    font-weight: 500;
    splay: flex;
    align-items: center;
  }
  .checklistblock li img {
    width: 20px;
    margin-right: 5px;
  }
  .infocontent_box {
    max-width: 611px;
    margin: 0 auto;
  }
  span.infobadge {
    background: #FFB800;
    font-size: 17px;
    text-transform: uppercase;
    display: inline-block;
    padding: 4px 30px;
    line-height: 22px;
    border-radius: 100px;
    font-weight: 500;
    margin-bottom: 21px;
  }
  .infocontent_box p {
    font-size: 20px;
    line-height: 30px;
  }
  .imgbox img {
    border: 2px solid #000000;
  }
  .infocontent_box strong {
    font-weight: 500;
  }
  
  @media screen and (max-width: 991px) {
    .product-info-sec .sec-head {
      margin-bottom: 27px;
      gap: 10px;
    }
    .checklistblock {
        margin-top: 20px;
        gap: 10px;
    }
    .checklistblock li {
        font-size: 14px;
    }
    .checklistblock li img {
        width: 15px;
        margin-right: 7px;
    }
    .infocontent_box p {
        font-size: 14px;
        line-height: 20px;
    }
    span.infobadge {
      padding: 7px 15px;
      font-size: 11px;
      text-align: center;
      width: 100%;
      line-height: 14px;
      margin-bottom: 10px;
  }
    .imgbox img {
      border: 1px solid #000000;
    }
  }
  @media screen and (max-width: 767px) {
    .infocontent_box {
      margin-top: 15px;
    }
  }
{%- endstyle -%}


<!-- --------------------- Product Info Section --------------------- -->
<section class="product-info-sec" style="background-color:{{section.settings.bgcolor}};color:{{section.settings.textcolor}};">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-4 col-12">
        <div class="imgbox">
          <img loading='lazy'  src="{{ section.settings.leftimage | image_url }}" class="img-fluid" alt="{{ section.settings.secheading | escape }}" width="auto" height="auto" loading="lazy">
        </div>
      </div>
      <div class="col-md-8 col-12">
        <div class="infocontent_box">
          
    {% if section.settings.secheading != blank %}
    <div class="sec-head d-flex flex-column text-left">
      <h2 class="sec-title">{{section.settings.secheading}}</h2>
      <div class="sec-description">{{section.settings.secdescription}}</div>
    </div>
    {% endif %}
          {% if section.settings.badgetxt != blank %}
          <span class="infobadge text-center">{{section.settings.badgetxt}}</span>
          {% endif %}
          {% if section.settings.blockdescription != blank %}
          <div>{{section.settings.blockdescription}}</div>
          {% endif %}
          <ul class="checklistblock">
            {% for block in section.blocks %}
              {% if block.settings.listtxt != blank %}
              <li><img loading='lazy'  src="{{ block.settings.image | image_url }}" alt="Ticker Image" width="auto" height="auto" loading="lazy" fetchpriority="low" /> {{block.settings.listtxt}}</li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Product Info Section",
    "settings": [      
      {
        "type": "color",
        "id": "bgcolor",
        "label": "Background Color"
      },
      {
        "type": "color",
        "id": "textcolor",
        "label": "Text Color"
      },
      {
        "type": "html",
        "id": "secheading",
        "label": "Section Heading"
      },
      {
        "type": "richtext",
        "id": "secdescription",
        "label": "Section Description"
      },
      {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "image_picker",
      "id": "leftimage",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "badgetxt",
      "label": "Badge Text"
    },
    {
      "type": "richtext",
      "id": "blockdescription",
      "label": "Block Description"
    }
    ],
    "blocks": [
      {
        "type": "Text",
        "name": "List Item",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "listtxt",
            "label": "List Title"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Product Info Section",
        "category": "Product Info Section"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

