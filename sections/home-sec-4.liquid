<div class="sec3_home">
  <div class="sec3_home_left">
    <h2> {{ section.settings.heading }} </h2>
    <div class="divthree">
      <p> {{ section.settings.description }}  </p>
      <button onclick="window.location='{{ section.settings.btn-link }}'" class="black_btn"> {{ section.settings.btn-text }} </button>
    </div>
  </div>
  
  <div class="sec3_home_right">
    <img src="{{ section.settings.image | img_url:'720x' }} " width="100%">
  </div>
  
  <div class="divfour text-center">
      <p>{{section.settings.description}}</p>
      <button onclick="window.location='{{ section.settings.btn-link }}'" class="black_btn"> {{ section.settings.btn-text }} </button>
    </div>
</div>






{% schema %}
  {
    "name": "Our Story",
    "settings": [
                  {
                   "type":"text",
                   "id":"heading",
                   "label":"Heading"
                 },
                 {
                   "type":"textarea",
                   "id":"description",
                   "label":"Description"
                 },
                 {
                   "type":"text",
                   "id":"btn-text",
                   "label":"Button Text"
                 },
                 {
                   "type":"url",
                   "id":"btn-link",
                   "label":"Button Link"
                 },
                 {
                   "type":"image_picker",
                   "id":"image",
                   "label":"Select Image"
                 }
                ],

      "presets":[{
                 "name":"Our Story",
                 "category":"custom"
              }]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}

<style> 
  .divfour{display:none!important;}
  
  @media screen and (max-width: 768px){
    .sec3_home_left{text-align: center; }
  .sec3_home_left h2{font-size: 20px;}
    .divthree{display:none!important;}
    .divfour{display:block!important; padding: 20px;}
  
  }
    
    
  
  



</style>