

<div class="bg_gray">
<div class="container last_sec_prod">
    <div class="row r_f">
        <div class="col-12 col-md-6 col-lg-6 last_sec_prod_right">
            <h1> {{ section.settings.heading }} </h1>
            <p> {{ section.settings.subheading }} </p>
            <button onclick="window.location='{{ section.settings.btn-link }}'" class="black_btn"> {{ section.settings.btn-text }} </button>
        </div>
        <div class="col-12 col-md-6 col-lg-6 last_sec_prod_left">
            <img src=" {{ section.settings.image | image_url }} " alt="{{ section.settings.image.alt }}" loading="lazy" fetchpriority="low" width="auto" height="auto">
        </div>
    </div>
</div>
</div>



{% schema %}
  {
    "name": "Wanna Collab",
    "settings": [
     {
       "type":"text",
       "id":"heading",
       "label":"Heading"
     },
     {
       "type":"textarea",
       "id":"subheading",
       "label":"Subheading"
     },
     {
       "type":"text",
       "id":"btn-text",
       "label":"Button Text"
     },
     {
       "type":"url",
       "id":"btn-link",
       "label":"Button Link"
     },
     {
       "type":"image_picker",
       "id":"image",
       "label":"Right Image"
     }
   ],
   "presets":[
     {
       "name":"Wanna Collab"
     }
   ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
