$(document).on("click", '.custom_products_flex_item_link a', function(e) {  
e.preventDefault();
var current_tab = $(this).attr('data_tab');
$('.custom_hk_popup[data_tab="'+current_tab+'"]').show();
$('.custom_hk_popup[data_tab="'+current_tab+'"]').find('.slick-slider').slick('refresh');
});
$(document).on("click", '.custom_hk_popup_bg, .custom_hk_popup_close', function(e) {  
e.preventDefault();
var current_tab = $(this).attr('data_tab');
$('.custom_hk_popup').hide();
});





