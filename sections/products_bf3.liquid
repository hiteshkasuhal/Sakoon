  <div class="quantity_button_custom quantity_plus_custom">+</div>
  <label for="quantity-{{ product.id }}" style="display:none;">Product Quantity</label>
  <input type="number" readonly value="1" name="quantity_custom"  price="{{ product.selected_or_first_available_variant.price }}" variant_id="{{ product.selected_or_first_available_variant.id }}"  id="quantity-{{ product.id }}">
