$(document).on("click", '.custom_products_flex_item_add_to_cart2:not([disabled])', function(e) { 
var input = $(this).parents('.custom_hk_popup').find('input');
var current_value = parseInt(input.val());
var current_tab=$(this).parents('.custom_hk_popup').attr('data_tab');
var main_div = $('.custom_products_flex_item_link a[data_tab="'+current_tab+'"]').parents('.custom_products_flex_item');
main_div.find('.custom_products_flex_item_link+.custom_products_flex_item_add_to_cart').trigger('click');
main_div.find('input').val(current_value);
main_div.find('.custom_products_flex_item_link+.custom_products_flex_item_add_to_cart').trigger('click');
$('.custom_hk_popup').hide();
});
$(document).mouseup(function(e) {
    var container = $(".quantity_show");
    if (!container.is(e.target) && container.has(e.target).length === 0) {
        container.removeClass('quantity_show');
    }
});

$(document).on("click", '.custom_products_flex_item_image', function(e) { 
$(this).parents('.custom_products_flex_item').find('.custom_products_flex_item_add_to_cart:not([style="display:none;"])').trigger('click');
});



 document.addEventListener('scroll', () => {
    function isInViewport(element) {
      const rect = element.getBoundingClientRect();
      return(rect.top >= 0 && rect.left >= 0 && rect.bottom <= (window.innerHeight || document.documentElement.clientHeight) && rect.right <= (window.innerWidth || document.documentElement.clientWidth));
    }

    if ( ! isInViewport(document.querySelector('.custom_customize_button')) &&  ! isInViewport(document.querySelector('.first_h1_heading'))
        &&  ! isInViewport(document.querySelector('.unlock_items_flex'))) {
      document.querySelector('.custom_customize_button_sticky').classList.add("sticky_button");
    } else {
      document.querySelector('.custom_customize_button_sticky').classList.remove("sticky_button");
    }
  });
</script>

