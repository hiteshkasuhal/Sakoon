     <div class="richtext_blocks_custom {{ section.settings.position }} block_{{ section.id }}  content_block_{{ section.id }}" style="background-color:{{ section.settings.bg_color2 | default:'transparent' }};color:{{ section.settings.color | default:'#000' }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
            {% if block.settings.h1 != true %}
              <h2 class="rich-text_custom__heading  inline-richtext {{ block.settings.custom_class }} {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
              {% else %}
              <h1 class="rich-text_custom__heading  inline-richtext {{ block.settings.custom_class }} {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h1>
              {% endif %} 
            {%- when 'richtext' -%}
              <div  class="rich-text_custom__richtext  {{ block.settings.custom_class }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            
            {%- when 'text' -%}
              <div  class="rich-text_custom__text  {{ block.settings.custom_class }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            
            {%- when 'html' -%}
              <div class="rich-text_custom__html  {{ block.settings.custom_class }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- when 'image' -%}
            {% if block.settings.image != blank %}
              <div  class="rich-text_custom__image  {{ block.settings.custom_class }}" {{ block.shopify_attributes }} >
  <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt }}" width="auto" height="auto" loading="{{ block.settings.loading }}" {% if block.settings.image_mobile != blank %} class="desktop_only"{% endif %}>
            {% if block.settings.image_mobile != blank %}
  <img src="{{ block.settings.image_mobile | image_url }}" alt="{{ block.settings.image_mobile.alt }}" width="auto" height="auto" loading="{{ block.settings.loading }}" class="mobile_only">
              {% endif %}
              </div>
              {% endif %}
            {%- when 'button' -%}
              <div class="rich-text_custom__buttons {{ block.settings.custom_class }}" {{ block.shopify_attributes }}>
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.button_link | default:'#'}}" class="button  button--primary">{{- block.settings.button_label  -}} <span>{{ block.settings.button_arrow }}</span></a>
                {%- endif -%}
              </div>
            {%- when 'checkout_button' -%}
            <div class="custom_customize_button">
            <div class="custom_customize_button_sticky">
            <div class="rich-text_custom__buttons checkout_button_custom "><a href="#" class="button  button--primary" disabled="disabled"><span class="checkout_price">{{ 0 | money_without_trailing_zeros }}</span> • Checkout Now →<span></span></a></div>
            </div>
             </div>
            {%- when 'image_with_text' -%}
              <div  class="rich-text_custom__image_with_text  {{ block.settings.custom_class }}" {{ block.shopify_attributes }}>
                <div class="image_with_text_left">
                  {% if block.settings.image != blank %}
                  <div class="image_with_text_left_image">
            <img src="{{ block.settings.image | image_url }}" width="auto" height="auto" loading="lazy" alt="{{ block.settings.image.alt }}">  
                    </div>
                  {% endif %}
                </div>
                <div class="image_with_text_right">
                  {% if block.settings.title != blank %}
                  <div class="image_with_text_right_title">{{ block.settings.title }}</div>
                  {% endif %}
                  {% if block.settings.text != blank %}
                  <div class="image_with_text_right_text">{{ block.settings.text }}</div>
                  {% endif %}
                </div>
              </div>
            

            
         
            {%- when 'image_with_link' -%}
            {% if block.settings.image != blank %}
              <div  class="rich-text-new__image_with_link rich-text_custom__image {{ block.settings.custom_class }}" {{ block.shopify_attributes }} >
                {% if block.settings.url != blank %}
                  <a href="{{block.settings.url | default:'#' }}">
                {% endif %}
  <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt }}" width="auto" height="auto" loading="{{ block.settings.loading }}" {% if block.settings.image_mobile != blank %} class="desktop_only"{% endif %}>
            {% if block.settings.image_mobile != blank %}
  <img src="{{ block.settings.image_mobile | image_url }}" alt="{{ block.settings.image_mobile.alt }}" width="auto" height="auto" loading="{{ block.settings.loading }}" class="mobile_only">
              {% endif %}
                {% if block.settings.url != blank %}
                  </a>
                {% endif %}
              </div>
              {% endif %}
            
            
     
            {% endcase %}
       {% endfor %}
     </div>


       {% if section.settings.position_image == 'right' %}
         <div class="image_with_text_image image_block_{{ section.id }}">
           {% if section.settings.image != blank %}
  <img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.image.alt }}" width="auto" height="auto" loading="{{ section.settings.loading }}" {% if section.settings.image_mobile != blank %} class="desktop_only"{% endif %}>
          
           {% endif %}
              {% if section.settings.image_mobile != blank %}
  <img src="{{ section.settings.image_mobile | image_url }}" alt="{{ section.settings.image_mobile.alt }}" width="auto" height="auto" loading="{{ section.settings.loading }}" class="mobile_only">
              {% endif %}
           {% if section.settings.text_below != blank %}
             <div class="custom_text_below desktop_only" style="color:{{ section.settings.color | default:'#000' }};">{{ section.settings.text_below }}</div>
           {% endif %}
         </div>
       {% endif %}
       
     </div>
   </div>
  </div>


{% schema %}
  {
    "name": "Products BF",
    "settings": [
       {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    },
      {
      "type": "image_picker",
      "id": "bg",
      "label": "Section Background"
    },
      {
      "type": "image_picker",
      "id": "bg_mobile",
      "label": "Section Background Mobile"
    },
     {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color"
    },
      {
      "type": "image_picker",
      "id": "bg2",
      "label": "Section Block Background"
    },
     {
      "type": "color",
      "id": "bg_color2",
      "label": "Section Block Background Color"
    },
     {
      "type": "color",
      "id": "color",
      "label": "Section Block Text Color"
    },
    {
      "type": "select",
      "id": "position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Content position"
    },
    {
      "type": "select",
      "id": "position_image",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "label": "Image position"
    },
    {
      "type": "range",
      "id": "content_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Size Of Content on Desktop",
      "default": 50
    },
      {
      "type": "inline_richtext",
      "id": "text_above",
      "label": "Text Above"
    },
      {
      "type": "product_list",
      "id": "products",
