<script>
// ---------- helpers ----------
function setActiveTabByUrl(url) {
  var path = new URL(url, window.location.origin).pathname;
  var $tabs = $('.collelction_grid_tab_link');
  var found = false;

  $tabs.each(function () {
    var tabUrl = $(this).attr('data-url') || $(this).attr('data_url');
    if (!tabUrl) return;
    var tabPath = new URL(tabUrl, window.location.origin).pathname;
    if (tabPath === path) {
      $(this).addClass('active').siblings('.collelction_grid_tab_link').removeClass('active');
      found = true;
      return false; // break
    }
  });

  // If no match, just clear others
  if (!found) $tabs.removeClass('active');
}

function loadGrid(url, pushHistory = true) {
  var $grid = $('#product-grid');
  if (!$grid.length) return;

  // Optional loading state
  $grid.addClass('is-loading');

  return fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
    .then(function (res) { return res.text(); })
    .then(function (html) {
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var incoming = doc.querySelector('#product-grid');

      if (!incoming) throw new Error('No #product-grid found at ' + url);

      // Replace the whole UL to keep structure identical
      var $incoming = $(incoming);
      $grid.replaceWith($incoming);

      if (pushHistory) history.pushState({ url: url }, '', url);

      // Sync the active tab to current URL
      setActiveTabByUrl(url);
    })
    .catch(function (err) {
      console.error(err);
      // Optional: show a small error message to the user
      // $('.collection-status').text('Could not load products. Please try again.');
    })
    .finally(function () {
      $('#product-grid').removeClass('is-loading');
    });
}

// ---------- click handler ----------
$(document).on('click', '.collelction_grid_tab_link', function (e) {
  e.preventDefault();

  var $tab = $(this);
  // Add active to this tab, remove from siblings
  $tab.addClass('active').siblings('.collelction_grid_tab_link').removeClass('active');

  // Get URL from data attribute (supports data-url or data_url)
  var url = $tab.attr('data-url') || $tab.attr('data_url');
  if (!url) return;

  loadGrid(url, true);
});

// ---------- back/forward support ----------
window.addEventListener('popstate', function (evt) {
  var url = (evt.state && evt.state.url) ? evt.state.url : location.href;
  loadGrid(url, false);
});

// ---------- optional: on initial load, sync active tab to current URL ----------
$(function () {
  setActiveTabByUrl(location.href);
});
// ---- helpers ----
function isMobile() {
  return window.matchMedia('(max-width: 767px)').matches; // adjust if needed
}

function setupTabSlider($content) {
  if (isMobile()) {
    if (!$content.hasClass('slick-initialized')) {
      $content.slick({
        mobileFirst: true,
        slidesToShow: 3,
        slidesToScroll: 1,
        infinite: true,
        dots: true,
        arrows: false,
  speed: 250,                  // shorter = snappier
  cssEase: 'cubic-bezier(.22,.61,.36,1)', // easeOut-ish
  swipeToSlide: true,
  touchThreshold: 12,          // bump from default 5 to reduce micro-stutters
  waitForAnimate: false,       // don't queue animations
        // destroy slick automatically when >= 768px
        responsive: [{ breakpoint: 768, settings: 'unslick' }]
      });
    }
  } else if ($content.hasClass('slick-initialized')) {
    $content.slick('unslick');
  }
}
// ---- on load: init currently active tab content ----
$(document).ready(function(){
  //$('.collelction_grid_tab_link:first-child').trigger('click');
  setupTabSlider($('.collelction_grid_tab_content.active'));

});
// ---------- click handler ----------
$(document).on('click', '.collelction_grid_tab', function (e) {
  e.preventDefault();

  var $tab = $(this);
  var data_tab=$tab.attr('data_tab');
  $('.collelction_grid_tab_content').hide().removeClass('active');
  var $content = $('.collelction_grid_tab_content[data_tab="'+data_tab+'"]').show().addClass('active');
  // Add active to this tab, remove from siblings
  $tab.addClass('active').siblings('.collelction_grid_tab').removeClass('active');

  // init/destroy slider based on viewport
  setupTabSlider($content);
  // Get URL from data attribute (supports data-url or data_url)
  var url = $tab.attr('data-url') || $tab.attr('data_url');
  if (!url) return;

  loadGrid(url, true);
  setupTabSlider($content);
});
// ---- handle viewport changes (debounced) ----
let resizeTO;
$(window).on('resize', function () {
  clearTimeout(resizeTO);
  resizeTO = setTimeout(function () {
    $('.collelction_grid_tab_content.active').each(function () {
      setupTabSlider($(this));
    });
  }, 150);
});
</script>


<script>
(function ($) {
  // Read param from data-url OR data_url, strip any leading ? or &
  function getParamFromTab($el) {
    var raw = $el.attr('data-url') || $el.attr('data_url') || '';
    return raw.replace(/^[?&]+/, '');
  }

  // Build URL with all active tabs
  function updateUrlFromActiveTabs() {
    // Collect & de-duplicate
    var params = Array.from(new Set(
      $('.ingredient_tab.active').map(function () {
        return getParamFromTab($(this));
      }).get().filter(Boolean)
    ));

    var base = window.location.origin + window.location.pathname;
    var newUrl = params.length ? (base + '?' + params.join('&')) : base;

    // Update URL only (no refresh)
    history.replaceState({ filters: params }, '', newUrl);
  loadGrid(newUrl, true);
  }

  // Toggle active on click and refresh URL
  $(document).on('click', '.ingredient_tab', function (e) {
    e.preventDefault();
    $(this).toggleClass('active');
    updateUrlFromActiveTabs();
  });
})(jQuery);
</script>