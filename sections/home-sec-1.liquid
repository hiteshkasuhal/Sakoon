


<div class="sec1_home">
  <div class="sec1_home_left">
    <h1> {{ section.settings.heading }} </h1>
    <p> {{ section.settings.description }} </p>
    <button onclick="window.location='{{ section.settings.btn-link }}'" class="yellow_btn"> {{ section.settings.btn-text }} </button>
  </div>
  <div class="sec1_home_right">
    <img src=" {{ section.settings.image | img_url:'720x' }} " width="100%">
  </div>
</div>







{% schema %}
  {
    "name": "Hero Section",
    "settings": [
                 {
                   "type":"text",
                   "id":"heading",
                   "label":"Heading"
                 },
                 {
                   "type":"textarea",
                   "id":"description",
                   "label":"Description"
                 },
                 {
                   "type":"text",
                   "id":"btn-text",
                   "label":"Button Text"
                 },
                 {
                   "type":"url",
                   "id":"btn-link",
                   "label":"Button Link"
                 },
                 {
                   "type":"image_picker",
                   "id":"image",
                   "label":"Select Image"
                 }
                ],
    "presets":[
                {
                  "name":"Hero Section",
                  "category":"custom"
                }
              ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

