{% for block in section.blocks %}
  {% if block.type == "mega-menu" %}
<div class="asyncLoad megamenu" id="MegaMenu">
        <div class="megamenuInner">
            <div class="menuLinks">
                <ul>
                  {% for collection in block.settings.collections %}
                    <li class="{% if forloop.first %}active{% endif %}" id="menuItem{{ forloop.index }}"><a href="{{ collection.url }}">{{ collection.title }}</a></li>
                  {% endfor %}
                </ul>
            </div>
            <div class="menuSlider">
            {% for collection in block.settings.collections %}
            <div class="swiper menuSliderSl" id="menuItem{{ forloop.index }}a">
                    <div class="swiper-wrapper">
                      {% for product in collection.products %}
                        <div class="swiper-slide">
                            <div class="menuItem">
                                <div class="menuImg">
                                  <a href="{{ product.url }}">
                                    <img src="{{ product.featured_image | image_url }}" alt="{{ product.title }}" loading="lazy" fetchpriority="low" width="auto" height="auto">
                                    </a>
                                    <button class="menuBtn" onclick="window.location='{{ product.url }}'">{{ product.title | truncatewords: 3 }}</button>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    <div class="swiper-button-next"></div>
                    <div class="swiper-button-prev"></div>
                </div>
              {% endfor %}
            </div>
        </div>
    </div>
    {% endif %}
{% endfor %}


