{% schema %}
  {
    "name": "Header",
    "settings": [
                   
                    {
                        "type": "select",
                        "id": "logo",
                        "label": "Logo Img Or Svg",
                        "options": [
                    {
                        "value": "img",
                        "label": "Img"
                    },
                    {
                        "value": "svg",
                        "label": "SVG"
                    }
                    
                    ],
                        "default": "svg"
                    },
                   {
                         "type":"image_picker",
                         "id":"logo-img",
                         "label":"Select Logo"
                    },
                    {
                         "type":"text",
                         "id":"logo-svg",
                         "label":"Svg Src"
                    },
                  {
                    "type":"text",
                    "id":"announcement",
                    "label":"Announcement Bar Text"
                  },
                  {
                    "type":"link_list",
                    "id":"main",
                    "label":"Main Menu"
                  },
                  {
                    "type":"link_list",
                    "id":"secondary",
                    "label":"Secondary Menu"
                  }
                   
                ],
    "blocks":[
                  {
                    "type":"mega-menu",
                    "name":"Mega Menu",
                     "limit": 1,
                    "settings":[
                                {
                                "type":"number",
                                "id":"menu_no",
                                "label":"Mega Menu Parent Link Index",
                                "info": "Type the index of the link where you want to add mega menu"
                                },
                                {
                                  	"type":"collection_list",
                                  	"id":"collections",
                                  	"label":"Select Collections",
                                    "limit":6
                                }
                               ]
                  }
    ]
  }
{% endschema %}

