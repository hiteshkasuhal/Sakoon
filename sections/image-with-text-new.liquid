{% capture layout %}
{%- style -%}
  
{% if section.settings.bg != blank %}
    .section_bg_{{ section.id }} {
      background-image:url({{section.settings.bg | image_url}});
    background-size: cover;
    background-attachment: unset;
    background-repeat: no-repeat;
    background-position: bottom;
    }
  {% endif %}
{% if section.settings.bg2 != blank %}
    .block_{{ section.id }} {
      background-image:url({{section.settings.bg2 | image_url}});
    background-size: cover;
    background-attachment: unset;
    background-repeat: no-repeat;
    background-position: bottom;
    }
  {% endif %}
{% if section.settings.bg_mobile != blank %}
  @media screen and (max-width: 915px) {
    .section_bg_{{ section.id }} {
      background-image:url({{section.settings.bg_mobile | image_url}});
    }
  }
  {% endif %}
  @media screen and (max-width: 915px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    .image_block_{{ section.id }} {
      max-width:100%;
      width:100%;
    }
    .content_block_{{ section.id }} {
      max-width:100%;
      width:100%;
    }
  }
  @media screen and (min-width: 915px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .image_block_{{ section.id }} {
      max-width:{{section.settings.image_size}}%;
      width:100%;
    }
    .content_block_{{ section.id }} {
      max-width:{{section.settings.content_size}}%;
      width:100%;
    }
  }
{%- endstyle -%}

<div class="image_with_text_new_main section_bg_{{ section.id }} {{ section.settings.custom_class }}"{% if section.settings.custom_id != blank %} id="{{ section.settings.custom_id }}"{% endif %}
style="background-color:{{ section.settings.bg_color | default:'transparent' }}">
   <div class="page-width section-{{ section.id }}-padding isolate">
     <div class="image_with_text_flex{% if section.settings.position_image == 'left' %} image_left_custom{% endif %}{% if section.settings.position_image == 'right' %} image_right_custom{% endif %}">
       {% if section.settings.position_image == 'left' %}
         <div class="image_with_text_image image_block_{{ section.id }}">
           {% if section.settings.image != blank %}
  <img  src="{{ section.settings.image | image_url }}" alt="{{ section.settings.image.alt }}" width="auto" height="auto" loading="{{ section.settings.loading }}" {% if section.settings.image_mobile != blank %} class=" desktop_only" {% else %}class=" "{% endif %}>
            {% if section.settings.image_mobile != blank %}
  <img class="" src="{{ section.settings.image_mobile | image_url }}" alt="{{ section.settings.image_mobile.alt }}" width="auto" height="auto" loading="{{ section.settings.loading }}" class="mobile_only ">
              {% endif %}
           {% endif %}
           {% if section.settings.text_below != blank %}
             <div class="custom_text_below desktop_only" style="color:{{ section.settings.color | default:'#000' }};">{{ section.settings.text_below }}</div>
           {% endif %}
         </div>
       {% endif %}
     <div class="richtext_blocks_custom {{ section.settings.position }} block_{{ section.id }}  content_block_{{ section.id }}" style="background-color:{{ section.settings.bg_color2 | default:'transparent' }};color:{{ section.settings.color | default:'#000' }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
            {% if block.settings.h1 != true %}
              <h2 class="rich-text_custom__heading  inline-richtext {{ block.settings.custom_class }} {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
              {% else %}
              <h1 class="rich-text_custom__heading  inline-richtext {{ block.settings.custom_class }} {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h1>
              {% endif %} 
            {%- when 'richtext' -%}
              <div  class="rich-text_custom__richtext  {{ block.settings.custom_class }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            
            {%- when 'text' -%}
              <div  class="rich-text_custom__text  {{ block.settings.custom_class }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            
            {%- when 'html' -%}
              <div class="rich-text_custom__html  {{ block.settings.custom_class }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- when 'image' -%}
            {% if block.settings.image != blank %}
              <div  class="rich-text_custom__image  {{ block.settings.custom_class }}" {{ block.shopify_attributes }} >
  <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt }}" width="auto" height="auto" loading="{{ block.settings.loading }}" {% if block.settings.image_mobile != blank %} class="desktop_only " {% else %}class=""{% endif %}>
            {% if block.settings.image_mobile != blank %}
  <img src="{{ block.settings.image_mobile | image_url }}" alt="{{ block.settings.image_mobile.alt }}" width="auto" height="auto" loading="{{ block.settings.loading }}" class="mobile_only ">
              {% endif %}
              </div>
              {% endif %}
            {%- when 'button' -%}
              <div class="rich-text_custom__buttons {{ block.settings.custom_class }}" {{ block.shopify_attributes }}>
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.button_link | default:'#'}}" class="button  button--primary">{{- block.settings.button_label  -}} <span>{{ block.settings.button_arrow }}</span></a>
                {%- endif -%}
              </div>
            
            {%- when 'image_with_text' -%}
              <div  class="rich-text_custom__image_with_text  {{ block.settings.custom_class }}" {{ block.shopify_attributes }}>
                <div class="image_with_text_left">
                  {% if block.settings.image != blank %}
                  <div class="image_with_text_left_image">
            <img class="" src="{{ block.settings.image | image_url }}" width="auto" height="auto" loading="lazy" alt="{{ block.settings.image.alt }}">  
                    </div>
                  {% endif %}
                </div>
                <div class="image_with_text_right">
                  {% if block.settings.title != blank %}
                  <div class="image_with_text_right_title">{{ block.settings.title }}</div>
                  {% endif %}
                  {% if block.settings.text != blank %}
                  <div class="image_with_text_right_text">{{ block.settings.text }}</div>
                  {% endif %}
                </div>
              </div>
            

            {%- when 'image_with_link' -%}
            {% if block.settings.image != blank %}
              <div  class="rich-text-new__image_with_link {{ block.settings.custom_class }}" {{ block.shopify_attributes }} >
                {% if block.settings.url != blank %}
                  <a href="{{block.settings.url | default:'#' }}">
                {% endif %}
  <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt }}" width="auto" height="auto" loading="{{ block.settings.loading }}" {% if block.settings.image_mobile != blank %} class="desktop_only " {% else %}class=""{% endif %}>
            {% if block.settings.image_mobile != blank %}
  <img src="{{ block.settings.image_mobile | image_url }}" alt="{{ block.settings.image_mobile.alt }}" width="auto" height="auto" loading="{{ block.settings.loading }}" class="mobile_only ">
              {% endif %}
                {% if block.settings.url != blank %}
                  </a>
                {% endif %}
              </div>
              {% endif %}
            
         
            
     
            {% endcase %}
       {% endfor %}
     </div>


       {% if section.settings.position_image == 'right' %}
         <div class="image_with_text_image image_block_{{ section.id }}">
           {% if section.settings.image != blank %}
  <img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.image.alt }}" width="auto" height="auto" loading="{{ section.settings.loading }}" {% if section.settings.image_mobile != blank %} class=" desktop_only" {% else %}class=""{% endif %}>
          
           {% endif %}
              {% if section.settings.image_mobile != blank %}
  <img src="{{ section.settings.image_mobile | image_url }}" alt="{{ section.settings.image_mobile.alt }}" width="auto" height="auto" loading="{{ section.settings.loading }}" class=" mobile_only">
              {% endif %}
           {% if section.settings.text_below != blank %}
             <div class="custom_text_below desktop_only" style="color:{{ section.settings.color | default:'#000' }};">{{ section.settings.text_below }}</div>
           {% endif %}
         </div>
       {% endif %}
       
     </div>
   </div>
  </div>
{% endcapture %}
{{ layout | replace: "<img","<img loading='eager' " }}

