    <input type="" name="">
     <label>Password</label>
    <input type="" name="">
     <label>Confirm Pasword</label>
    <input type="" name="">
    <button>JOIN</button>
  </form> -->
  <img src=" {{ section.settings.image | img_url:'master' }} " id="img29">
</div>


{% schema %}
  {
    "name": "Affiliate",
    "settings": [
                 {
                   "type":"image_picker",
                   "id":"bg",
                   "label":"Background Image"
                 },
                 {
                   "type":"image_picker",
                   "id":"logo",
                   "label":"Select Logo"
                 },
                 {
                   "type":"text",
                   "id":"heading",
                   "label":"Heading"
                 },
                 {
                   "type":"header",
                   "content":"Benefits"
                 },
                 {
                   "type":"text",
                   "id":"benefits",
                   "label":"Heading"
                 },
                 {
                   "type":"image_picker",
                   "id":"image",
                   "label":"Form Background Image"
                 }
    
                ],
  "blocks":[
              {
                "name":"benefits",
                "type":"benefits",
                "settings":[
                            {
                              "type":"text",
                              "id":"heading",
                              "label":"Heading"
                            },
                            {
                              "type":"textarea",
                              "id":"description",
                              "label":"Description"
                            }
                           ]
              }
           ],
    "presets":[
      {
        "name":"Affiliate Page "
      }
    ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}



<script>
 function onChange() {
  const password = document.querySelector('#password');
  const confirm = document.querySelector('#confirm_password');
  if (confirm.value === password.value) {
    confirm.setCustomValidity('');
  } else {
    confirm.setCustomValidity('Passwords do not match');
  }
}
</script>