
<div class="sec1_home sec1_affiliate">
  <img src=" {{ section.settings.bg | img_url:'master' }} " width="100%" class="desktop_item">
  <div class="sec1_contact_inner">
      <img src="{{ section.settings.logo | img_url:'master' }}" class="affiliate_logo">
      <h1>{{ section.settings.heading }}</h1>
  </div>
</div>


 
<div class="sec2_contact sec2_affiliate">
  <h3> {{ section.settings.benefits }} </h3>
  
  {% for block in section.blocks %}
  <div class="sec2_affiliate_flx">
   
    <div class="sec2_affiliate_flx_left">
      <p> {{ block.settings.heading }} </p>
     
    </div>
    

    <div class="sec2_affiliate_flx_right">
      
     
      <div class="sec2_affiliate_flx_right_right_txt">
        <img src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/tick.png?v=1641222746">
        <span> {{ block.settings.description }} </span>
      </div>
     
     
    </div>
  </div>
 {% endfor %}
  
  
  {%- form 'contact', id: 'ContactForm', class:'affiliate_form' -%}
    {%- if form.posted_successfully? -%}
      <div class="form-status form-status-list form__message" tabindex="-1" autofocus>{% render 'icon-success' %} {{ 'templates.contact.form.post_success' | t }}</div>
    {%- elsif form.errors -%}
      <div class="form__message">
        <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>{% render 'icon-error' %} {{ 'templates.contact.form.error_heading' | t }}</h2>
      </div>
      <ul class="form-status-list caption-large" role="list">
        <li>
          <a href="#ContactForm-email" class="link">
            {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
          </a>
        </li>
      </ul>
    {%- endif -%}
   
       <label class="" for="ContactForm-name">First Name</label>
        <input class="" autocomplete="name" type="text" id="ContactForm-First_Name" name="contact[First_Name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="">
      
     
  
  <label class="" for="ContactForm-name">Last Name</label>
        <input class="" autocomplete="name" type="text" id="ContactForm-Last_Name" name="contact[Last_Name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="">
      
     
  
      <label class="" for="ContactForm-email">{{ 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span></label>
        <input
          autocomplete="email"
          type="email"
          id="ContactForm-email"
          class=""
          name="contact[email]"
          spellcheck="false"
          autocapitalize="off"
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          aria-required="true"
          {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="ContactForm-email-error"
          {% endif %}
          placeholder=""
        >
       
        {%- if form.errors contains 'email' -%}
          <small class="contact__field-error" id="ContactForm-email-error">
            <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
            <span class="form__message">{% render 'icon-error' %}{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</span>
          </small>
        {%- endif -%}
     
       <label class="" for="">Password</label>
        <input  type="password" class="" autocomplete="" id="password" name="contact[Password]" onChange="onChange()"  placeholder="" required>
        
     
  
         <label class="" for="">Confirm Password</label>
        <input type="password" class="" autocomplete=""id="confirm_password" name="contact[Confiorm_Password]" onChange="onChange()"  placeholder="" required>
       
      
    
   
   
    
    
    <div class="contact__button">
      <button type="submit" class="">
      JOIN
      </button>
    </div>
  {%- endform -%}
  
  
