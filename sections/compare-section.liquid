{%- style -%}
  .compare-sec {
    padding-top: {{ section.settings.padding_top | times: 0.41 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.64 | round: 0 }}px;
  }
  
   @media screen and (min-width: 767px) {
    .compare-sec {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
  }
 
  @media screen and (min-width: 1024px) {
    .compare-sec {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  
  .compare-sec .sec-head {
    margin-bottom: 74px;
    gap: 20px;
  }
  .customrating img {
    max-width: 139px;
  }
  .customrating span {
      font-size: 24px;
      margin-left: 10px;
  }
  .customrating {
      display: flex;
      align-items: center;
      justify-content: center;
  }

  .brandproductimg {
      max-width: 121px;
      margin-top: -150px;
  }
  .brandlogoimg {
      max-width: 170px;
  }
  .tabelrow {
      display: flex;
      flex-wrap: wrap;
  }
  .tablerow {
    display: flex;
    flex-wrap: wrap;
    min-height:74px;
  }
  .tablerow .table_col {
      flex: 0 0 33.33%;
      max-width: 33.33%;
      display: flex;
      align-items: center;
  }
  .compare_table {
      max-width: 700px;
      margin: 220px auto 0;
      background: #1F1F1F;
      border: 4px solid #FFFFFF;
      border-radius: 40.94px;
  }
  .table_col.secondcol {
      background: #FFB800;
      justify-content: center;
      text-align: center;
      position: relative;
  }
  .table_head .table_col.secondcol:before {
      content: "";
      position: absolute;
      /* width: 100%; */
      height: 42px;
      background: #FFB800;
      bottom: 100%;
      border-radius: 40px 40px 0 0;
      border: 4px solid #fff;
      border-bottom: 0;
      left: -4px;
      right: -4px;
  }
  .tablebody .tablerow:last-of-type .secondcol:after {
      content: "";
      position: absolute;
      /* width: 100%; */
      height: 42px;
      background: #FFB800;
      top: 100%;
      border-radius: 0 0 40px 40px;
      border: 4px solid #fff;
      border-top: 0;
      left: -4px;
      right: -4px;
  }
  .compare_table .secondcol {
      border-left: 4px solid #fff;
      border-right: 4px solid #fff;
  }
  .table_col.thirdcol{
    text-align:center;
  }
  .tablebody .tablerow:nth-of-type(odd) .colcontent {
      background: rgb(0 0 0 / 5%);
  }
  .colcontent {
      width: 100%;
      display: flex;
      height: 100%;
      align-items: center;
      padding: 10px 25px;
      z-index: 1;
  }
  .secondcol .colcontent,
  .thirdcol .colcontent {
      justify-content: center;
  }
  .compare_table span {
      font-weight: 500;
      font-size: 20px;
  }
  .table_head span {
      font-weight: 700;
      font-size: 22.33px;
  }

  @media screen and (max-width: 991px) {
    .compare-sec .sec-head {
      margin-bottom: 27px;
      gap: 10px;
    }
    .customrating span {
        font-size: 15px;
    }
    .customrating img {
        max-width: 92px;
    }

  }
  @media screen and (max-width: 767px) {
    .brandproductimg {
        max-width: 60px;
        margin-top: -50px;
    }
    .compare_table span {
        font-size: 11px;
    }
    .tableicon {
        width: 20px;
    }
    .tablerow {
        min-height: 40px;
    }
    .brandlogoimg {
        max-width: 85px;
    }
    .table_head span {
        font-size: 11.33px;
    }
    .colcontent {
        padding: 10px 15px;
    }
    .table_head .table_col.secondcol:before {
        height: 22px;
        border-radius: 20px 20px 0 0;
        border: 2px solid #fff;
        left: -2px;
        right: -2px;
        border-bottom:0;
    }
    .compare_table {
        margin: 69px auto 0;
        border: 2px solid #FFFFFF;
        border-radius: 20px;
    }
    .tablebody .tablerow:last-of-type .secondcol:after {
        height: 21px;
        border-radius: 0 0 20px 20px;
        border: 2px solid #fff;
        border-top: 0;
        left: -2px;
        right: -2px;
    }
    .compare_table .secondcol {
        border-left: 2px solid #fff;
        border-right: 2px solid #fff;
    }
  }
{%- endstyle -%}


<!-- --------------------- Compare Section --------------------- -->
<section class="compare-sec" style="background-color:{{section.settings.bgcolor}};color:{{section.settings.textcolor}};">
  <div class="container">
    {% if section.settings.secheading != blank %}
    <div class="sec-head d-flex flex-column text-center">
      <div class="customrating">
        <img src="{{ section.settings.ratingimg | image_url }}" class="img-fluid" alt="rating stars" width="auto" height="auto" loading="lazy"><span>{{section.settings.ratingtxt}}</span>
      </div>
      <h2 class="sec-title">{{section.settings.secheading}}</h2>
      <div class="sec-description">{{section.settings.secdescription}}</div>
    </div>
    {% endif %}
    <div class="comparetableblock">
      {% if section.settings.brandproductimg != blank %}
      <div class="compare_table">
        <div class="table_head">
          <div class="tablerow">
            <div class="table_col firstcol"><div class="colcontent"></div></div>
            <div class="table_col secondcol">
              <div class="colcontent">
                <div class="tableimgblock">
                  <img src="{{ section.settings.brandproductimg | image_url }}" class="brandproductimg img-fluid"  alt="brandproductimg" width="auto" height="auto" loading="lazy"/>
                  <img src="{{ section.settings.brandlogoimg | image_url }}" class="brandlogoimg img-fluid" alt="brandlogoimg" width="auto" height="auto" loading="lazy" />
                </div>
              </div>
            </div>
            <div class="table_col thirdcol">
              <div class="colcontent">
                <span>{{section.settings.otherbrandtitle}}</span>
              </div>
            </div>
          </div>
        </div>
        <div class="tablebody">
          {% for block in section.blocks %}
            {% if block.settings.comparetitle != blank %}
            <div class="tablerow">
              <div class="table_col firstcol">
                <div class="colcontent">
                  <span>{{block.settings.comparetitle}}</span>
                </div>
              </div>
              <div class="table_col secondcol">
                  <div class="colcontent">
                    <img src="{{ block.settings.ourbrandimg | image_url }}" class="checkimg tableicon img-fluid" alt="checkimg" width="auto" height="auto" loading="lazy" />
                  </div>
              </div>
              <div class="table_col thirdcol">
                <div class="colcontent">
                  <img src="{{ block.settings.otherbrandimg | image_url }}" class="cancelimg tableicon img-fluid" alt="cancelimg" width="auto" height="auto" loading="lazy" />
                </div>
              </div>
            </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Compare Section",
    "settings": [      
      {
        "type": "color",
        "id": "bgcolor",
        "label": "Background Color"
      },
      {
        "type": "color",
        "id": "textcolor",
        "label": "Text Color"
      },
      {
        "type": "html",
        "id": "secheading",
        "label": "Section Heading"
      },
      {
        "type": "richtext",
        "id": "secdescription",
        "label": "Section Description"
      },
      {
        "type": "image_picker",
        "id": "ratingimg",
        "label": "Rating Star Image"
      },
      {
        "type": "text",
        "id": "ratingtxt",
        "label": "Rating Text"
      },
      {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },    
    {
      "type": "image_picker",
      "id": "brandproductimg",
      "label": "Brand Product Image"
    },
    {
      "type": "image_picker",
      "id": "brandlogoimg",
      "label": "Brand Logo Image"
    },
    {
      "type": "text",
      "id": "otherbrandtitle",
      "label": "Other Brand Title"
    }
    ],
    "blocks": [
      {
        "type": "Text",
        "name": "Table Row",
        "settings": [
          {
            "type": "text",
            "id": "comparetitle",
            "label": "Compare Title"
          },
          {
            "type": "image_picker",
            "id": "ourbrandimg",
            "label": "Our Brand Icon/Image"
          },
          {
            "type": "image_picker",
            "id": "otherbrandimg",
            "label": "Other Brand Icon/Image"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Compare Section",
        "category": "Compare Section"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

