{% comment %}
  Renders cart drawer
  
  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }
</style>
<input type="hidden" value="{{ cart.currency.symbol }}" id="cartSymbol">
<input type="hidden" value="{{ cart.currency.iso_code }}" id="cartCurrency">
<label for="hasFreeOn100" style="display:none;">freeGiftCheck 100</label>
<input type="checkbox" class="freeGiftCheck" id="hasFreeOn100" {% if settings.show_gift1 %}checked{% endif %}>
<label for="hasFreeOn150" style="display:none;">freeGiftCheck 150</label>
<input type="checkbox" class="freeGiftCheck" id="hasFreeOn150" {% if settings.show_gift2 %}checked{% endif %}>
{% if settings.show_gift1 %}
<input type="hidden" value="{{ settings.free_product_1.first_available_variant.id }}" id="freeOn100">
<input type="hidden" value="{{ settings.gift1_ammount | times : 100 }}" id="threshold100">
{% endif %}
{% if settings.show_gift2 %}
<input type="hidden" value="{{ settings.free_product_2.first_available_variant.id }}" id="freeOn150">
<input type="hidden" value="{{ settings.gift2_ammount | times : 100 }}" id="threshold150">
{% endif %}
{% assign cartItemsP = '' %}
{% assign totalItems = 0 %}
{% for item in cart.items %}
  {% assign tempID = item.product_id | append: ',' %}
  {% assign cartItemsP = tempID | append: cartItemsP %}
{% endfor %}
{% assign cartItems = '' %}
{%- for item in cart.items -%}
  {% assign cartItems = cartItems | append: item.variant_id %}
  {% assign cartItems = cartItems | append: ',' %}
{% endfor %}
<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      <div class="drawer__header">
        <h2 class="drawer__heading">{{ 'sections.cart.title' | t }}</h2>
        <button
          class="drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'icon-close' %}
        </button>
      </div>
      {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <div class="cart-drawer__warnings center{% if settings.cart_drawer_collection != blank %} cart-drawer__warnings--has-collection{% endif %}">
            <div class="cart-drawer__empty-content">
              <h2 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h2>
              <button
                class="drawer__close"
                type="button"
                onclick="this.closest('cart-drawer').close()"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                {% render 'icon-close' %}
              </button>
              <a href="{{ routes.all_products_collection_url }}" class="button">
                {{ 'general.continue_shopping' | t }}
              </a>

              {%- if shop.customer_accounts_enabled and customer == null -%}
                <p class="cart__login-title h3">{{ 'sections.cart.login.title' | t }}</p>
                <p class="cart__login-paragraph">
                  {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
                </p>
              {%- endif -%}
            </div>
          </div>
          {%- if settings.cart_drawer_collection != blank -%}
            <div class="cart-drawer__collection">
              {% render 'card-collection', card_collection: settings.cart_drawer_collection, columns: 1 %}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {% if cart != empty %}
        {%- for item in cart.items -%}
          {% if item.variant.selling_plan_allocations.size > 0 %}
            {% if item.selling_plan_allocation %}
              {% assign hasSub = true %}
            {% else %}
              {% assign hasSub = false %}
              {% break %}
            {% endif %}
          {% endif %}
        {% endfor %}
        {%- if settings.show_freeship and settings.show_gift1 and settings.show_gift2 -%}
          {% assign freeShipF = settings.free_ship_amount | times: 1 %}
          {% assign freeProduct1 = settings.gift1_ammount | times: 100 %}
          {% assign freeProduct2 = settings.gift2_ammount | times: 100 %}
          {% assign freeProduct2100 = settings.gift2_ammount %}
          {% assign freeShipFAmount = settings.free_ship_amount | times: 100 %}
          <div class="cart-progress-bar drawer-item {{ freeShipF }} {{ freeShipFAmount }}">
            {% if cart.total_price >= freeProduct2 %}
              <p class="content_threshold threshold_congrats free-ship-text">
                You got <strong>Free Shipping & Free Gifts</strong>.
              </p>
            {% elsif cart.total_price >= freeProduct1 %}
              <p class="content_threshold threshold_congrats free-ship-text">
                Spend <strong>{{ freeProduct2 | minus: cart.total_price | money }}</strong> more to get
                <strong>Free {{ settings.free_product_2.title }}</strong>.
              </p>
            {% elsif cart.total_price >= freeShipFAmount %}
              <p class="content_threshold threshold_congrats free-ship-text">
                Spend <strong>{{ freeProduct1 | minus: cart.total_price | money }}</strong> more to get
                <strong>Free {{ settings.free_product_1.title }}</strong>.
              </p>
            {% else %}
              <p class="content_threshold threshold_congrats free-ship-text">
                {% if hasSub %}
                  Spend <strong>{{ freeProduct1 | minus: cart.total_price | money }}</strong> more to get
                  <strong>Free {{ settings.free_product_1.title }}</strong>.
                {% else %}
                  Spend <strong>{{ freeShipFAmount | minus: cart.total_price | money }}</strong> more to get
                  <strong>Free Shipping</strong>.
                {% endif %}
              </p>
            {% endif %}
            <div class="progress-container">
              <div
                class="milestone-start star-half desktop-mile"
                style="left:calc({{ freeShipFAmount | divided_by : settings.gift2_ammount | round: 2 }}% - 50px)"
              >
                <div class="milestone-img"><img src="{{ 'freeship.png' |  asset_img_url : 'master' }}" width="auto" height="auto" loading="lazy" fetchpriority="low" alt="free shipping"></div>
                <div class="milestone-content">{{ freeShipFAmount | money_without_trailing_zeros }}</div>
              </div>
              {% if settings.show_gift1 %}
              <div
                class="milestone-start star-half desktop-mile"
                style="left:calc({{ freeProduct1 | divided_by : settings.gift2_ammount | round: 2 }}% - 50px)"
              >
                <div class="milestone-img">
                  <img src="{{ settings.free_product_1.featured_image |  img_url : 'master' }}" width="auto" height="auto" loading="lazy" fetchpriority="low" alt="free product">
                </div>
                <div class="milestone-content">{{ freeProduct1 | money_without_trailing_zeros }}</div>
              </div>
             {% endif %}
          {% if settings.show_gift2 %}
              <div
                class="milestone-start star-half desktop-mile"
                style="left:calc({{ freeProduct2 | divided_by : settings.gift2_ammount | round: 2 }}% - 50px)"
              >
                <div class="milestone-img">
                  <img src="{{ settings.free_product_2.featured_image |  img_url : 'master' }}" width="auto" height="auto" loading="lazy" fetchpriority="low" alt="free product">
                </div>
                <div class="milestone-content">{{ freeProduct2 | money_without_trailing_zeros }}</div>
              </div>
           {% endif %}
              <div
                class="milestone-start star-half mobile-mile"
                style="left:calc({{ freeShipFAmount | divided_by : settings.gift2_ammount | round: 2 }}% - 40px)"
              >
                <div class="milestone-img"><img src="{{ 'freeship.png' |  asset_img_url : 'master' }}"></div>
                <div class="milestone-content">{{ freeShipFAmount | money_without_trailing_zeros }}</div>
              </div>
              <div
                class="milestone-start star-half mobile-mile"
                style="left:calc({{ freeProduct1 | divided_by : settings.gift2_ammount | round: 2 }}% - 40px)"
              >
                <div class="milestone-img">
                  <img src="{{ settings.free_product_1.featured_image |  img_url : 'master' }}" width="auto" height="auto" loading="lazy" fetchpriority="low" alt="free shipping">
                </div>
                <div class="milestone-content">{{ freeProduct1 | money_without_trailing_zeros }}</div>
              </div>
              <div
                class="milestone-start star-half mobile-mile"
                style="left:calc({{ freeProduct2 | divided_by : settings.gift2_ammount | round: 2 }}% - 40px)"
              >
                <div class="milestone-img">
                  <img src="{{ settings.free_product_2.featured_image |  img_url : 'master' }}" width="auto" height="auto" loading="lazy" fetchpriority="low" alt="free shipping">
                </div>
                <div class="milestone-content">{{ freeProduct2 | money_without_trailing_zeros }}</div>
              </div>
              <div
                class="bar-progress"
                {% if cart.total_price >= freeShipFAmount %}
                  {% if cart.total_price >= freeProduct2 %}
                    style="width:100%"
                  {% else %}
                    style="width:calc({{ cart.total_price | divided_by : freeProduct2100 | round: 2 }}% - 30px)"
                  {% endif %}
                {% else %}
                  {% if hasSub %}
                    style="width:calc({{ freeShipFAmount | divided_by : freeProduct2100 | round: 2 }}% - 30px)"
                  {% else %}
                    {% if cart.total_price >= freeProduct2 %}
                      style="width:100%"
                    {% else %}
                      style="width:calc({{ cart.total_price | divided_by : freeProduct2100 | round: 2 }}% - 30px)"
                    {% endif %}
                  {% endif %}
                {% endif %}
              ></div>
            </div>
          </div>
        {%- elsif settings.show_freeship and settings.show_gift1 -%}
          {% assign freeShipF = settings.free_ship_amount | times: 1 %}
          {% assign freeProduct1 = settings.gift1_ammount | times: 100 %}
          {% assign freeProduct2 = settings.gift1_ammount | times: 100 %}
          {% assign freeProduct2100 = settings.gift1_ammount %}
          {% assign freeShipFAmount = settings.free_ship_amount | times: 100 %}
          <div class="cart-progress-bar drawer-item {{ freeShipF }} {{ freeShipFAmount }}">
            {% if cart.total_price >= freeProduct2 %}
              <p class="content_threshold threshold_congrats free-ship-text">
                You got <strong>Free Shipping & Free Gifts</strong>.
              </p>
            {% elsif cart.total_price >= freeShipFAmount %}
              <p class="content_threshold threshold_congrats free-ship-text">
                Spend <strong>{{ freeProduct1 | minus: cart.total_price | money }}</strong> more to get
                <strong>Free {{ settings.free_product_1.title }}</strong>.
              </p>
            {% else %}
              <p class="content_threshold threshold_congrats free-ship-text">
                {% if hasSub %}
                  Spend <strong>{{ freeProduct1 | minus: cart.total_price | money }}</strong> more to get
                  <strong>Free {{ settings.free_product_1.title }}</strong>.
                {% else %}
                  Spend <strong>{{ freeShipFAmount | minus: cart.total_price | money }}</strong> more to get
                  <strong>Free Shipping</strong>.
                {% endif %}
              </p>
            {% endif %}
            <div class="progress-container">
              <div class="milestone-start star-half desktop-mile" style="left:calc({{ freeShipFAmount | divided_by : settings.gift1_ammount | round: 2 }}% - 50px)">
                <div class="milestone-img"><img src="{{ 'freeship.png' |  asset_img_url : 'master' }}" width="auto" height="auto" loading="lazy" fetchpriority="low" alt="free shipping"></div>
                <div class="milestone-content">{{ freeShipFAmount | money_without_trailing_zeros }}</div>
              </div>
              {% if settings.show_gift1 %}
              <div class="milestone-start star-half desktop-mile" style="left:calc({{ freeProduct1 | divided_by : settings.gift1_ammount | round: 2 }}% - 50px)">
                <div class="milestone-img"><img src="{{ settings.free_product_1.featured_image |  img_url : 'master' }}" width="auto" height="auto" loading="lazy" fetchpriority="low" alt="free product"></div>
                <div class="milestone-content">{{ freeProduct1 | money_without_trailing_zeros }}</div>
              </div>
             {% endif %}
              <div class="milestone-start star-half mobile-mile" style="left:calc({{ freeShipFAmount | divided_by : settings.gift1_ammount | round: 2 }}% - 40px)">
                <div class="milestone-img"><img src="{{ 'freeship.png' |  asset_img_url : 'master' }}" width="auto" height="auto" loading="lazy" fetchpriority="low" alt="free shipping"></div>
                <div class="milestone-content">{{ freeShipFAmount | money_without_trailing_zeros }}</div>
              </div>
              <div class="milestone-start star-half mobile-mile"  style="left:calc({{ freeProduct1 | divided_by : settings.gift1_ammount | round: 2 }}% - 40px)">
                <div class="milestone-img"> <img src="{{ settings.free_product_1.featured_image |  img_url : 'master' }}" width="auto" height="auto" loading="lazy" fetchpriority="low" alt="free product"> </div>
                <div class="milestone-content">{{ freeProduct1 | money_without_trailing_zeros }}</div>
              </div>
              <div
                class="bar-progress"
                {% if cart.total_price >= freeShipFAmount %}
                  {% if cart.total_price >= freeProduct2 %}
                    style="width:100%"
                  {% else %}
                    style="width:calc({{ cart.total_price | divided_by : freeProduct2100 | round: 2 }}% - 30px)"
                  {% endif %}
                {% else %}
                  {% if hasSub %}
                    style="width:calc({{ freeShipFAmount | divided_by : freeProduct2100 | round: 2 }}% - 30px)"
                  {% else %}
                    {% if cart.total_price >= freeProduct2 %}
                      style="width:100%"
                    {% else %}
                      style="width:calc({{ cart.total_price | divided_by : freeProduct2100 | round: 2 }}% - 30px)"
                    {% endif %}
                  {% endif %}
                {% endif %}
              ></div>
            </div>
          </div>
        {%- elsif settings.show_freeship -%}
          {% assign freeShipF = settings.free_ship_amount | times: 1 %}
            {% assign freeProduct1 = settings.free_ship_amount | times: 100 %}
            {% assign freeProduct2 = settings.free_ship_amount | times: 100 %}
            {% assign freeProduct2100 = settings.free_ship_amount %}
            {% assign freeShipFAmount = settings.free_ship_amount | times: 100 %}
            <div class="cart-progress-bar drawer-item {{ freeShipF }} {{ freeShipFAmount }}">
              {% if cart.total_price >= freeProduct2 %}
                <p class="content_threshold threshold_congrats free-ship-text">
                  You got <strong>Free Shipping</strong>.
                </p>
              {% else %}
                <p class="content_threshold threshold_congrats free-ship-text">
                  {% if hasSub %}
                    You got <strong>Free Shipping</strong>.
                  {% else %}
                    Spend <strong>{{ freeShipFAmount | minus: cart.total_price | money }}</strong> more to get
                    <strong>Free Shipping</strong>.
                  {% endif %}
                </p>
              {% endif %}
              <div class="progress-container">
                <div class="milestone-start star-half desktop-mile" style="left:calc({{ freeShipFAmount | divided_by : settings.free_ship_amount | round: 2 }}% - 50px)">
                  <div class="milestone-img"><img src="{{ 'freeship.png' |  asset_img_url : 'master' }}" width="auto" height="auto" loading="lazy" fetchpriority="low" alt="free shipping"></div>
                  <div class="milestone-content">{{ freeShipFAmount | money_without_trailing_zeros }}</div>
                </div>
                <div class="milestone-start star-half mobile-mile" style="left:calc({{ freeShipFAmount | divided_by : settings.free_ship_amount | round: 2 }}% - 40px)">
                  <div class="milestone-img"><img src="{{ 'freeship.png' |  asset_img_url : 'master' }}" width="auto" height="auto" loading="lazy" fetchpriority="low" alt="free product"></div>
                  <div class="milestone-content">{{ freeShipFAmount | money_without_trailing_zeros }}</div>
                </div>
                <div
                  class="bar-progress"
                  {% if cart.total_price >= freeShipFAmount %}
                    {% if cart.total_price >= freeProduct2 %}
                      style="width:100%"
                    {% else %}
                      style="width:calc({{ cart.total_price | divided_by : freeProduct2100 | round: 2 }}% - 30px)"
                    {% endif %}
                  {% else %}
                    {% if hasSub %}
                      style="width:calc({{ freeShipFAmount | divided_by : freeProduct2100 | round: 2 }}% - 30px)"
                    {% else %}
                      {% if cart.total_price >= freeProduct2 %}
                        style="width:100%"
                      {% else %}
                        style="width:calc({{ cart.total_price | divided_by : freeProduct2100 | round: 2 }}% - 30px)"
                      {% endif %}
                    {% endif %}
                  {% endif %}
                ></div>
              </div>
            </div>
        {% endif %}
        {% if settings.show_autoship %}
        <div class="subscription-header {% if hasSub %}active{% endif %}" >
          <cart-remove-sub
            class="sub-remover sub-changer"
            {% unless hasSub %}
              style="display:none"
            {% endunless %}
            ><button>
              <img src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/default.png?v=1678866900" width="auto" height="auto" loading="lazy" fetchpriority="low" alt="default"> {{settings.autoship_text}}
            </button>
        </cart-remove-sub>
        <cart-add-sub
          class="sub-adder sub-changer"
          {% if hasSub %}
            style="display:none"
          {% endif %}
          ><button>
            <img src="https://cdn.shopify.com/s/files/1/0296/4848/6460/files/Toggle-off.png?v=1677839365" width="auto" height="auto" loading="lazy" fetchpriority="low" alt="toggle"> {{settings.autoship_text}}
          </button>
        </cart-add-sub>
        <div class="info_icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="currentColor"
            class="bi bi-info-circle"
            viewBox="0 0 16 16"
          >
            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/> <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
          </svg>
          <div class="redBubble bubblePosition hoverBubble">
            <p>signup for monthly discounted shipments</p>
          </div>
        </div>
        </div>
        {% endif %}
      {% endif %}
      <cart-drawer-items
        {% if cart == empty %}
          class=" is-empty"
        {% endif %}
      >
        <form
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="cart__contents cart-drawer__form"
          method="post"
        >
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <div class="drawer__cart-items-wrapper">
                <table class="cart-items" role="table">
                  <thead role="rowgroup">
                    <tr role="row">
                      <th id="CartDrawer-ColumnProductImage" role="columnheader">
                        <span class="visually-hidden">{{ 'sections.cart.headings.image' | t }}</span>
                      </th>
                      <th
                        id="CartDrawer-ColumnProduct"
                        class="caption-with-letter-spacing"
                        scope="col"
                        role="columnheader"
                      >
                        {{ 'sections.cart.headings.product' | t }}
                      </th>
                      <th
                        id="CartDrawer-ColumnTotal"
                        class="right caption-with-letter-spacing"
                        scope="col"
                        role="columnheader"
                      >
                        {{ 'sections.cart.headings.total' | t }}
                      </th>
                      <th id="CartDrawer-ColumnQuantity" role="columnheader">
                        <span class="visually-hidden">{{ 'sections.cart.headings.quantity' | t }}</span>
                      </th>
                    </tr>
                  </thead>

                  <tbody role="rowgroup">
                    {%- for item in cart.items -%}
                      <tr
                        id="CartDrawer-Item-{{ item.index | plus: 1 }}"
                        class="cart-item{% if item.selling_plan_allocation %} has-sub{% endif %}"
                        role="row"
                      >
                        <td class="cart-item__media" role="cell" headers="CartDrawer-ColumnProductImage">
                          {% if item.variant.selling_plan_allocations.size > 0 %}
                            {% if item.selling_plan_allocation %}
                              <input
                                class="subscriptions splan_{{ item.index | plus: 1 }}"
                                type="checkbox"
                                value="{{ item.selling_plan_allocation.selling_plan.id }}"
                                data-qty="{{ item.quantity }}"
                                data-index="{{ item.index | plus: 1 }}"
                                data-id="{{ item.variant_id }}"
                                checked
                              >
                            {% else %}
                              <input
                                class="subscriptions splan_{{ item.index | plus: 1 }}"
                                type="checkbox"
                                value="{{ item.variant.selling_plan_allocations.first.selling_plan.id }}"
                                data-qty="{{ item.quantity }}"
                                data-index="{{ item.index | plus: 1 }}"
                                data-id="{{ item.variant_id }}"
                              >
                            {% endif %}
                          {% endif %}
                          {% if item.image %}
                            {% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}
                            <a href="{{ item.url }}" class="cart-item__link" tabindex="-1" aria-hidden="true"> </a>
                            <img
                              class="cart-item__image"
                              src="{{ item.image | image_url: width: 100 }}"
                              alt="{{ item.image.alt | escape }}"
                              loading="lazy"
                              width="90"
                              height="{{ 90 | divided_by: item.image.aspect_ratio | ceil }}"
                            >
                          {% endif %}
                        </td>

                        <td class="cart-item__details" role="cell" headers="CartDrawer-ColumnProduct">
                          {%- if settings.show_vendor -%}
                            <p class="caption-with-letter-spacing light">{{ item.product.vendor }}</p>
                          {%- endif -%}
                          {%- if item.product.type == 'Gift' -%}
                            <a href="javascript:;" class="cart-item__name h4 break">
                              {{- item.product.title | escape -}}
                            </a>
                          {% else %}
                            <a href="{{ item.url }}" class="cart-item__name h4 break">
                              {{- item.product.title | escape -}}
                            </a>
                          {% endif %}

                          {%- if item.product.type == 'Gift' -%}
                          {% else %}
                            {%- if item.original_price != item.final_price -%}
                              <div class="cart-item__discounted-prices">
                                <span class="visually-hidden">
                                  {{ 'products.product.price.regular_price' | t }}
                                </span>
                                <s class="cart-item__old-price product-option">
                                  {{- item.original_price | money -}}
                                </s>
                                <span class="visually-hidden">
                                  {{ 'products.product.price.sale_price' | t }}
                                </span>
                                <strong class="cart-item__final-price product-option">
                                  {{ item.final_price | money }}
                                </strong>
                              </div>
                            {%- else -%}
                              <div class="product-option" data-ocu-price-block="{{ item.key }}">
                                {{ item.original_price | money }}
                              </div>
                            {%- endif -%}
                          {%- endif -%}

                          {%- if item.product.has_only_default_variant == false
                            or item.properties.size != 0
                            or item.selling_plan_allocation != null
                          -%}
                            <dl>
                              {%- if item.product.type == 'Gift' -%}
                                <div class="product-option">
                                  <dt>Gift</dt>
                                </div>
                              {% else %}
                                {%- if item.product.has_only_default_variant == false -%}
                                  {%- for option in item.options_with_values -%}
                                    <div class="product-option">
                                      <dt>{{ option.name }}:</dt>
                                      <dd>
                                        {{ option.value -}}
                                        {%- unless forloop.last %}, {% endunless %}
                                      </dd>
                                    </div>
                                  {%- endfor -%}
                                {%- endif -%}

                                {%- for property in item.properties -%}
                                  {%- assign property_first_char = property.first | slice: 0 -%}
                                  {%- if property.last != blank and property_first_char != '_' -%}
                                    <div class="product-option">
                                      <dt>{{ property.first }}:</dt>
                                      <dd>
                                        {%- if property.last contains '/uploads/' -%}
                                          <a
                                            href="{{ property.last }}"
                                            class="link"
                                            target="_blank"
                                            aria-describedby="a11y-new-window-message"
                                          >
                                            {{ property.last | split: '/' | last }}
                                          </a>
                                        {%- else -%}
                                          {{ property.last }}
                                        {%- endif -%}
                                      </dd>
                                    </div>
                                  {%- endif -%}
                                {%- endfor -%}
                              {%- endif -%}
                            </dl>

                            <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                          {%- endif -%}

