  </g>
  <defs>
    <clipPath id="clip0_35_27">
      <rect width="18.8279" height="11.9881" fill="white" transform="translate(0.958313 0.469727)"/>
    </clipPath>
  </defs>
</svg></p>
              <p>{{ card_product.metafields.custom.badge }}</p>
            </span>
          {%- endif -%}
        </div>
      </div>
	<div class="full-detailsd">
         <span class="full-details"><a href="{{ card_product.url }}">See full details</a></span>
            </div>  
	  
	  
    </div>
  </div>
{%- else -%}
  <div class="product-card-wrapper card-wrapper underline-links-hover">
    <div
      class="
        card
        card--{{ settings.card_style }}
        card--text
        {% if extend_height %} card--extend-height{% endif %}
        {% if settings.card_style == 'card' %} color-{{ settings.card_color_scheme }} gradient{% endif %}
        {% if card_product.featured_media == nil and settings.card_style == 'card' %} ratio{% endif %}
        {{ horizontal_class }}
      "
      style="--ratio-percent: 100%;"
    >
