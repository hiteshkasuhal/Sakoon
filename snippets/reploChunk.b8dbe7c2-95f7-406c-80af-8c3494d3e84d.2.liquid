[data-animation="bounceFlash"] {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    animation: bounceButton 2s infinite ease-in-out;
}

[data-animation="bounceFlash"]::before {
    content: "";
    display: block;
    position: absolute;
    top: 0;
    bottom: 0;
    width: 90px;
    left: -100%;
    transform: skewX(-30deg);
    background: linear-gradient(to right, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.56) 50%, rgba(255, 255, 255, 0) 100%);
    opacity: 0.5;
    animation: bounceFlash 3s infinite ease-in-out;
}


@keyframes bounceButton {
    0%, 20%, 50%, 80%, 100% {
        transform: translateY(0);
    }

    40% {
        transform: translateY(-10px);
    }

    60% {
        transform: translateY(-5px);
    }
}

@keyframes bounceFlash {
    0% {
        left: -100%;
    }

    50% {
        left: 100%;
    }

    100% {
        left: 100%;
    }
