          "type": "faq",
          "settings": {
            "question": "How many gummies should I take daily?",
            "answer": "<p>Take <strong>2 gummies daily,</strong> preferably with food or as directed by your healthcare professional. Do not exceed the recommended serving size.</p>"
          }
        },
        "faq_g4xp9G": {
          "type": "faq",
          "settings": {
            "question": "What are the main benefits of this mushroom complex?",
            "answer": "<p>This 10-mushroom blend is designed to <strong>support focus, mental clarity, energy, immune health,</strong> and overall daily wellness.</p>"
          }
        },
        "faq_Vq4AX9": {
          "type": "faq",
          "settings": {
            "question": "Are these gummies easy to take daily?",
            "answer": "<p>Yes. The gummies are designed to be simple, convenient, and easy to include in your <strong>daily wellness routine.</strong></p>"
          }
        },
        "faq_Rc47Hr": {
          "type": "faq",
          "settings": {
            "question": "Can both men and women take this?",
            "answer": "<p>Yes. The formula is designed for <strong>both men and women</strong> looking to support cognitive function, energy, and immune health.</p>"
          }
        },
        "faq_bNmg6R": {
          "type": "faq",
          "settings": {
            "question": "Does it contain animal-derived ingredients?",
            "answer": "<p>No. These gummies are <strong>vegan-friendly</strong> and made without animal-derived ingredients.</p>"
          }
        },
        "faq_A47V4L": {
          "type": "faq",
          "settings": {
            "question": "When can I expect to notice results?",
            "answer": "<p>Many users report noticing improvements in focus and energy within <strong>a few weeks of consistent daily use.</strong></p>"
          }
