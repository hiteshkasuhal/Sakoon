    "faq_lp_new_YCxN6D": {
      "type": "faq_lp_new",
      "blocks": {
        "faq_BLmR6k": {
          "type": "faq",
          "settings": {
            "question": "How many gummies should I take daily?",
            "answer": "<p>Take <strong>4 gummies daily</strong> to provide <strong>5g of creatine monohydrate per serving.</strong> They can be taken anytime during the day, with or without food.</p>"
          }
        },
        "faq_g4xp9G": {
          "type": "faq",
          "settings": {
            "question": "When is the best time to take creatine gummies?",
            "answer": "<p>Creatine can be taken <strong>before or after workouts,</strong> or anytime during the day. Consistency is more important than timing for optimal results.</p>"
          }
        },
        "faq_Vq4AX9": {
          "type": "faq",
          "settings": {
            "question": "Is this product easy to swallow?",
            "answer": "<p>Yes. The formula uses <strong>smooth liquid-filled vegan capsules,</strong> making them easy to swallow and convenient for daily use.</p>"
          }
        },
        "faq_Rc47Hr": {
          "type": "faq",
          "settings": {
            "question": "Do I need to mix this with water like regular creatine?",
            "answer": "<p>No. These gummies are designed for <strong>convenient daily use with no powders, scoops, or mixing required.</strong></p>"
          }
        },
        "faq_bNmg6R": {
          "type": "faq",
          "settings": {
            "question": "Can both men and women take this?",
            "answer": "<p>Yes. Creatine monohydrate is widely used by <strong>both men and women</strong> to support strength, performance, and muscle recovery.</p>"
          }
        },
        "faq_A47V4L": {
          "type": "faq",
          "settings": {
            "question": "Is this product vegan-friendly?",
            "answer": "<p>Yes. These gummies are made with <strong>vegan-friendly</strong> ingredients and contain <strong>no animal-derived gelatin.</strong></p>"
          }
        }
      },
