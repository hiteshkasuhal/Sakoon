      "blocks": {
        "faq_BLmR6k": {
          "type": "faq",
          "settings": {
            "question": "How many gummies should I take daily?",
            "answer": "<p>Take <strong>2 gummies daily,</strong> preferably with food or as directed by your healthcare professional. Do not exceed the recommended serving size.</p>"
          }
        },
        "faq_g4xp9G": {
          "type": "faq",
          "settings": {
            "question": "Is this multivitamin gentle on the stomach?",
            "answer": "<p>Yes. The formula is designed to be <strong>easy to digest and includes pre + probiotics</strong> to help support gut health.</p>"
          }
        },
        "faq_Vq4AX9": {
          "type": "faq",
          "settings": {
            "question": "Are these gummies vegan-friendly?",
            "answer": "<p>Yes. The gummies are made with <strong>plant-based</strong> ingredients and are suitable for a vegan lifestyle.</p>"
          }
        },
        "faq_Rc47Hr": {
          "type": "faq",
          "settings": {
            "question": "Can I take this with other supplements?",
            "answer": "<p>In most cases yes, but it’s best to consult your healthcare professional before combining supplements to ensure they fit your individual needs.</p>"
          }
        },
        "faq_bNmg6R": {
          "type": "faq",
          "settings": {
            "question": "Does it contain animal-derived ingredients?",
            "answer": "<p>No. The formula is vegan-friendly and <strong>free from animal-derived ingredients.</strong></p>"
          }
        },
