    "faq_lp_new_YCxN6D": {
      "type": "faq_lp_new",
      "blocks": {
        "faq_BLmR6k": {
          "type": "faq",
          "settings": {
            "question": "How many gummies should I take daily?",
            "answer": "<p>Take <strong>2 gummies daily</strong>, preferably with food or as directed by your healthcare professional. Do not exceed the recommended serving size.</p>"
          }
        },
        "faq_g4xp9G": {
          "type": "faq",
          "settings": {
            "question": "Is this product halal-friendly?",
            "answer": "<p>Yes. Sakoon Marine Collagen Gummies are <strong>halal-friendly and gelatin-free,</strong> made without pork-derived ingredients.</p>"
          }
        },
        "faq_Vq4AX9": {
          "type": "faq",
          "settings": {
            "question": "Do the gummies taste good?",
            "answer": "<p>Yes. These gummies feature a <strong>delicious tropical flavor,</strong> making them an easy and enjoyable addition to your daily routine.</p>"
          }
        },
        "faq_Rc47Hr": {
          "type": "faq",
          "settings": {
            "question": "Can both men and women take this?",
            "answer": "<p>Yes. These collagen gummies are designed for <strong>both men and women</strong> looking to support healthy skin, hair, nails, and connective tissue.</p>"
          }
        },
        "faq_bNmg6R": {
          "type": "faq",
          "settings": {
            "question": "Does it contain animal-derived ingredients?",
            "answer": "<p>Yes. The collagen used in this product is marine collagen <strong>sourced from fish</strong> (such as cod, haddock, and pollock).</p>"
          }
        },
        "faq_A47V4L": {
          "type": "faq",
          "settings": {
            "question": "When can I expect to notice results?",
            "answer": "<p>Results may vary, but many people begin noticing improvements in skin, hair, and nail health <strong>within a few weeks of consistent daily use.</strong></p>"
          }
        }
      },
