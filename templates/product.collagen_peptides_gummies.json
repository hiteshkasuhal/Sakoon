          }
        },
        "faq_g4xp9G": {
          "type": "faq",
          "settings": {
            "question": "What are the benefits of collagen gummies?",
            "answer": "<p>Collagen peptides help support<strong> skin elasticity, stronger hair and nails,</strong> and healthy joint mobility as part of your daily wellness routine.</p>"
          }
        },
        "faq_Vq4AX9": {
          "type": "faq",
          "settings": {
            "question": "Is this product halal-certified?",
            "answer": "<p>Yes. The collagen used in these gummies is <strong>halal-certified</strong> and sourced from approved bovine and chicken sources to meet halal standards.</p>"
          }
        },
        "faq_Rc47Hr": {
          "type": "faq",
          "settings": {
            "question": "Can both men and women take this?",
            "answer": "<p>Yes. Sakoon Halal Collagen Gummies are suitable for <strong>both men and women</strong> looking to support skin, hair, nails, and joint health.<br/></p>"
          }
        },
        "faq_bNmg6R": {
          "type": "faq",
          "settings": {
            "question": "Does it contain animal-derived ingredients?",
            "answer": "<p>Yes. The collagen is sourced from halal-certified <strong>bovine and chicken collagen peptides.</strong></p>"
          }
        },
        "faq_A47V4L": {
          "type": "faq",
          "settings": {
            "question": "When can I expect to notice results?",
            "answer": "<p>Many users begin noticing improvements in skin hydration, nail strength, and hair health <strong>within a few weeks of consistent daily use.</strong></p>"
          }
        }
