        "faq_BLmR6k": {
          "type": "faq",
          "settings": {
            "question": "How many gummies should I take daily?",
            "answer": "<p>Take <strong>3 gummies daily,</strong> preferably with food or as directed by your healthcare professional. Do not exceed the recommended serving size.</p>"
