          "type": "html",
          "settings": {
            "text": "{% assign rating = product.metafields.loox.avg_rating | default: 0 %}\n{% assign reviews = product.metafields.loox.num_reviews | default: 0 %}\n\n<div class=\"custom_icons_with_text_landing_page iron_day_list1\">\n  <div class=\"icons_with_text_flex\">\n    \n    <div class=\"icons_with_text_item\">\n      \n      <div class=\"icon_svg_main\">\n\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"94\" height=\"18\" viewBox=\"0 0 94 18\" fill=\"none\">\n\n        {% for i in (1..5) %}\n        {% assign star_start = i | minus: 1 | times: 19 %}\n        {% assign half_check = i | minus: 0.5 %}\n\n        {% if rating >= i %}\n\n        <!-- Full star -->\n        <path d=\"M{{ star_start | plus: 9 }} 0L{{ star_start | plus: 11.0206 }} 6.21885H{{ star_start | plus: 17.5595 }}L{{ star_start | plus: 12.2694 }} 10.0623L{{ star_start | plus: 14.2901 }} 16.2812L{{ star_start | plus: 9 }} 12.4377L{{ star_start | plus: 3.70993 }} 16.2812L{{ star_start | plus: 5.73056 }} 10.0623L{{ star_start | plus: 0.440492 }} 6.21885H{{ star_start | plus: 6.97937 }}L{{ star_start | plus: 9 }} 0Z\" fill=\"#D69800\"></path>\n\n        {% elsif rating >= half_check %}\n\n        <!-- Half star -->\n        <defs>\n          <clipPath id=\"half-star-{{ i }}\">\n            <rect x=\"{{ star_start }}\" y=\"0\" width=\"9.5\" height=\"18\"/>\n          </clipPath>\n        </defs>\n\n        <path d=\"M{{ star_start | plus: 9 }} 0L{{ star_start | plus: 11.0206 }} 6.21885H{{ star_start | plus: 17.5595 }}L{{ star_start | plus: 12.2694 }} 10.0623L{{ star_start | plus: 14.2901 }} 16.2812L{{ star_start | plus: 9 }} 12.4377L{{ star_start | plus: 3.70993 }} 16.2812L{{ star_start | plus: 5.73056 }} 10.0623L{{ star_start | plus: 0.440492 }} 6.21885H{{ star_start | plus: 6.97937 }}L{{ star_start | plus: 9 }} 0Z\" fill=\"#E5E5E5\"></path>\n\n        <path d=\"M{{ star_start | plus: 9 }} 0L{{ star_start | plus: 11.0206 }} 6.21885H{{ star_start | plus: 17.5595 }}L{{ star_start | plus: 12.2694 }} 10.0623L{{ star_start | plus: 14.2901 }} 16.2812L{{ star_start | plus: 9 }} 12.4377L{{ star_start | plus: 3.70993 }} 16.2812L{{ star_start | plus: 5.73056 }} 10.0623L{{ star_start | plus: 0.440492 }} 6.21885H{{ star_start | plus: 6.97937 }}L{{ star_start | plus: 9 }} 0Z\" fill=\"#D69800\" clip-path=\"url(#half-star-{{ i }})\"></path>\n\n        {% else %}\n\n        <!-- Empty star -->\n        <path d=\"M{{ star_start | plus: 9 }} 0L{{ star_start | plus: 11.0206 }} 6.21885H{{ star_start | plus: 17.5595 }}L{{ star_start | plus: 12.2694 }} 10.0623L{{ star_start | plus: 14.2901 }} 16.2812L{{ star_start | plus: 9 }} 12.4377L{{ star_start | plus: 3.70993 }} 16.2812L{{ star_start | plus: 5.73056 }} 10.0623L{{ star_start | plus: 0.440492 }} 6.21885H{{ star_start | plus: 6.97937 }}L{{ star_start | plus: 9 }} 0Z\" fill=\"#E5E5E5\"></path>\n\n        {% endif %}\n        {% endfor %}\n\n        </svg>\n\n      </div>\n\n      <span>\n        <p>\n          Rated {{ rating }}/5.0 |\n{% if rating < 4.5 %}\n<strong>“Great”</strong>\n{% else %}\n<strong>“excellent”</strong>\n{% endif %}\n        </p>\n      </span>\n\n    </div>\n\n  </div>\n</div>",
