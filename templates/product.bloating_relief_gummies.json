      "blocks": {
        "faq_BLmR6k": {
          "type": "faq",
          "settings": {
            "question": "How many gummies should I take daily?",
            "answer": "<p>Take <strong>2 gummies daily</strong>, preferably with food or as directed by your healthcare professional. Do not exceed the recommended serving size.</p>"
          }
        },
        "faq_g4xp9G": {
          "type": "faq",
          "settings": {
            "question": "Is this product gentle on digestion?",
            "answer": "<p>Yes. The formula includes plant-based ingredients traditionally used to <strong>support digestion and reduce bloating,</strong> making it suitable for daily use.</p>"
          }
        },
        "faq_Vq4AX9": {
          "type": "faq",
          "settings": {
            "question": "Will this help with bloating after meals?",
            "answer": "<p>These gummies are formulated with botanical ingredients like dandelion, buchu, and juniper berry, which are traditionally used to <strong>support digestive comfort and help reduce occasional bloating.</strong></p>"
          }
        },
        "faq_Rc47Hr": {
          "type": "faq",
          "settings": {
            "question": "Can both men and women take this?",
            "answer": "<p>Yes. Sakoon Bloat Relief Gummies are suitable for <strong>both men and women</strong> looking to support digestive comfort and fluid balance.</p>"
          }
        },
        "faq_bNmg6R": {
          "type": "faq",
          "settings": {
            "question": "Does it contain animal-derived ingredients?",
            "answer": "<p>No. The gummies are 100% <strong>vegan-friendly and made without animal-derived ingredients.</strong></p>"
          }
        },
        "faq_A47V4L": {
          "type": "faq",
          "settings": {
            "question": "When can I expect to notice results?",
            "answer": "<p>Many users report feeling digestive comfort <strong>within the first few days,</strong> while consistent daily use may provide the best support over time.</p>"
          }
        }
      },
