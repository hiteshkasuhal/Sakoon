      "blocks": {
        "faq_BLmR6k": {
          "type": "faq",
          "settings": {
            "question": "How many gummies should I take daily?",
            "answer": "<p>Take <strong>2 capsules daily</strong>, preferably with food or as directed by your healthcare professional. Do not exceed the recommended serving size.</p>"
          }
        },
        "faq_g4xp9G": {
          "type": "faq",
          "settings": {
            "question": "What makes this formula different from others?",
            "answer": "<p>This formula combines <strong>cold-pressed black seed oil with premium New Zealand Manuka honey,</strong> providing a unique blend designed to support immune, digestive, and overall wellness.</p>"
          }
        },
        "faq_Vq4AX9": {
          "type": "faq",
          "settings": {
            "question": "Is this product easy to swallow?",
            "answer": "<p>Yes. The formula uses <strong>smooth liquid-filled vegan capsules</strong>, making them easy to swallow and convenient for daily use.</p>"
          }
        },
        "faq_Rc47Hr": {
          "type": "faq",
          "settings": {
            "question": "Can both men and women take this?",
            "answer": "<p>Yes. This supplement is designed for <strong>both men and women</strong> who want to support their daily wellness routine.</p>"
          }
        },
        "faq_bNmg6R": {
          "type": "faq",
          "settings": {
            "question": "Is the formula halal-friendly?",
            "answer": "<p>Yes. These capsules are <strong>halal-friendly and made with vegan capsule shells,</strong> without gelatin or animal-derived capsule materials.</p>"
          }
        },
        "faq_A47V4L": {
          "type": "faq",
          "settings": {
            "question": "When can I expect to notice results?",
            "answer": "<p>Results may vary, but many people begin noticing improvements in overall wellness and digestive comfort <strong>within a few weeks of consistent daily use.</strong> For best results, take the capsules regularly as part of your daily routine.</p>"
          }
        }
      },
