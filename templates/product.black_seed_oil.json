      "blocks": {
        "faq_BLmR6k": {
          "type": "faq",
          "settings": {
            "question": "How many gummies should I take daily?",
            "answer": "<p>Take <strong>2 gummies daily</strong>, preferably with food or as directed by your healthcare professional. Do not exceed the recommended serving size.</p>"
          }
        },
        "faq_g4xp9G": {
          "type": "faq",
          "settings": {
            "question": "Is this product gentle on digestion?",
            "answer": "<p>Yes. Our formula includes black seed oil, honey extract, and apple cider vinegar to <strong>support digestive comfort</strong> while remaining easy to chew and enjoy.</p>"
          }
        },
        "faq_Vq4AX9": {
          "type": "faq",
          "settings": {
            "question": "Is it made with natural ingredients?",
            "answer": "<p>Yes. Our formula is crafted with carefully selected ingredients including black seed oil and natural honey, <strong>without artificial flavors or unnecessary additives.</strong></p>"
          }
        },
        "faq_Rc47Hr": {
          "type": "faq",
          "settings": {
            "question": "Can both men and women take this?",
            "answer": "<p>Absolutely. Black Seed & Honey Gummies are formulated <strong>for adult men and women</strong> seeking immune, digestive, and whole-body wellness support.</p>"
          }
        },
        "faq_bNmg6R": {
          "type": "faq",
          "settings": {
            "question": "Does it contain animal-derived ingredients?",
            "answer": "<p>No. These gummies are <strong>gelatin-free, made with pectin</strong>, and crafted to meet halal dietary standards.</p>"
          }
        },
        "faq_A47V4L": {
          "type": "faq",
          "settings": {
            "question": "When can I expect to notice results?",
            "answer": "<p>Many customers report digestive and energy support <strong>within a few weeks of consistent daily use.</strong> Results may vary depending on individual lifestyle and needs.</p>"
          }
        }
      },
