.custom_tab_section:not(#video) {
    background: transparent !important;
}
.trigger_tabs_main .trigger_tabs_item.active {
    background: rgba(255, 198, 59, 0.58);
    color: #000;
}

.product_bf_lp .page-width {
    padding-bottom: 50px;
}
.custom_products_flex_item_title {
    color: unset;
}
.custom_products_flex_item_link a {
    color: unset;
}
.custom_products_flex_item_link a:after {
    background: #000;
}
.custom_products_flex_item_add_to_cart svg path {
    fill: #fff;
}
.custom_products_flex_item_add_to_cart {
    background: #0073FF;
    color: #fff;
    border-color: #0073FF;
}
.custom_products_flex .custom_products_flex_item {
    border-color: #0000003b;
    background: #fff5dd;
}
.shopify-section-group-header-group {
    display: block;
}
ul.desk_links_ul {
    display: flex !important;
}
.custom_products_flex_item_add_to_cart {
    background: #ffc63b;
    color: #000;
}
.custom_products_flex_item_add_to_cart svg path {
    fill: #000;
}
.rich-text_custom__buttons.checkout_button_custom [disabled=disabled] {
    opacity: 1;
}
h1 strong, h2 strong {
    color: #000;
}
.sec-head h2.sec-title span {
    color: #000;
}

@media (max-width:915px) {
  .product_bf_lp .page-width {
    padding-bottom: 30px;
}
  .money_back_homepage {
    background-color: #fff5dd ! IMPORTANT;
}
}

@media (min-width:915px) {
.product_bf_lp .richtext_blocks_custom {
    position: sticky;
    top: 30px;
}
}